---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  title="Company Planner"
  eyebrow="Tools"
  description="Company planning for Victoria 3 lives in the Company Analysis Tool."
>
  <p class="moved">
    Company planning moved to <a href="https://alcaras.github.io/v3co/">the Company Analysis Tool</a>:
    coverage matrix, seven-slot optimiser, ownership and prestige-good filters, presets.
  </p>
  <p class="moved moved--sub">
    Underlying data — buildings, charters, prestige goods, prosperity bonus — on
    <a href={`${base}companies`}>Companies</a>.
  </p>

  <style is:global>
    .moved {
      font-size: 0.95rem; line-height: 1.6; max-width: 42rem;
      padding: 0.9rem 1.1rem; border-left: 3px solid var(--gold-deep);
      background: var(--bg-elev); border-radius: 0 8px 8px 0;
    }
    .moved--sub { font-size: 0.85rem; color: var(--text-dim); background: none; border-left-color: var(--border); }
  </style>
</Base>
