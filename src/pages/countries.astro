---
import Base from '../layouts/Base.astro';
import TableTools from '../components/TableTools.astro';
import countriesJson from '../data/countries.json';

const countries = (countriesJson as any).countries as any[];
const base = import.meta.env.BASE_URL;
const starters = countries.filter((c) => c.existsAtStart);
const formables = countries.filter((c) => c.formable && !c.existsAtStart);
const csv = {
  header: ['Country', 'Status', 'Tag', 'Type', 'Tier', 'Capital', 'Cultures', 'Religion'],
  rows: countries.map((c) => [
    c.name,
    c.existsAtStart ? 'on the 1836 map' : c.formable ? 'formable' : c.dynamic ? 'dynamic/releasable' : 'unused',
    c.tag,
    c.type ?? '', c.tier?.name ?? '', c.capital?.name ?? '',
    c.cultures.map((x: any) => x.name).join('; '), c.religion?.name ?? '',
  ]),
};
---
<Base
  title="Countries"
  active="countries"
  eyebrow="World"
  pageFilter="Filter countries…"
  pageStats={[
    { value: starters.length, label: 'on the 1836 map' },
    { value: formables.length, label: 'formable' },
    { value: countries.length - starters.length - formables.length, label: 'dynamic' },
  ]}
>
  <TableTools csvId="countries" csvName="victoria3-countries" />

  <div class="grid">
    <div class="grid__scroll">
      <table class="vtbl" id="countries-table" data-sortable>
        <thead>
          <tr>
            <th style="min-width: 15rem;">Country</th>
            <th style="width: 8rem;">Status</th>
            <th style="width: 4rem;">Tag</th>
            <th style="width: 9rem;">Type</th>
            <th style="width: 10rem;">Tier</th>
            <th style="width: 14rem;" title="For a formable tag this is the capital it adopts when formed, not a 1836 capital">Capital</th>
            <th>Primary cultures</th>
          </tr>
        </thead>
        <tbody>
          {countries.map((c) => (
            <tr id={c.tag} data-name={`${c.name} ${c.tag} ${c.type ?? ''} ${c.cultures.map((x: any) => x.name).join(' ')}`.toLowerCase()}>
              <td class="lead-cell" data-sort={c.name}>
                <span class="lead">
                  <span class="tagchip" style={`--tag-color: ${c.color ?? 'var(--border-strong)'}`}></span>
                  {c.name}
                </span>
              </td>
              <td class="dim" data-sort={c.existsAtStart ? '0' : c.formable ? '1' : '2'}>
                {c.existsAtStart ? '1836 map'
                  : c.formable ? <span title="Formed through a country-formation decision — its capital is the one it adopts on formation">formable</span>
                  : <span title="Released or spawned by script (civil wars, colonies)">dynamic</span>}
              </td>
              <td class="dim" style="font-family: var(--font-mono); font-size: 0.72rem;">{c.tag}</td>
              <td class="dim">{c.type?.replace('_', ' ') ?? <span class="cell__dash">—</span>}</td>
              <td class="dim">{c.tier?.name ?? <span class="cell__dash">—</span>}</td>
              <td class="dim">
                {c.capital ? <a href={`${base}states#${c.capital.id}`}>{c.capital.name}</a> : <span class="cell__dash">—</span>}
              </td>
              <td class="dim">{c.cultures.map((x: any) => x.name).join(', ') || <span class="cell__dash">—</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p class="caption">
    Swatches are the in-game map colors · formable and dynamic tags sort after the 1836 starters ·
    a formable's capital is the one it adopts on formation, so it may name a state it does not hold in 1836
  </p>

  <script is:inline define:vars={{ csv }}>
    window.v3Csv = window.v3Csv || {};
    window.v3Csv.countries = () => csv;
  </script>

  <script is:inline>
    const filter = document.getElementById('page-filter');
    if (filter) {
      const rows = [...document.querySelectorAll('#countries-table tbody tr')];
      filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        for (const r of rows) r.classList.toggle('is-hidden', !!q && !r.dataset.name.includes(q));
      });
    }
  </script>

  <style is:global>
    .tagchip {
      width: 14px; height: 14px; border-radius: 3px;
      background: var(--tag-color);
      border: 1px solid rgba(0,0,0,0.4);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.15);
      flex-shrink: 0;
    }
  </style>
</Base>
