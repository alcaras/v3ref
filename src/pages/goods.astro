---
import Base from '../layouts/Base.astro';
import TableTools from '../components/TableTools.astro';
import goodsJson from '../data/goods.json';

const base = import.meta.env.BASE_URL;
const goods = (goodsJson as any).goods as any[];
const categories = [...new Set(goods.map((g) => g.category))];

// One-line "top maker / top user" summary per good — full lists on its page.
const top = (list: any[]) =>
  list.length
    ? `${list[0].buildings[0]?.name ?? list[0].pmName}${list.length > 1 ? ` +${list.length - 1}` : ''}`
    : null;

// CSV export: the same rows the table shows, flattened. Building lists are
// distinct names joined with ';' — per-PM quantities live on the detail pages.
const buildingsOf = (list: any[]) =>
  [...new Set(list.flatMap((p: any) => p.buildings.map((b: any) => b.name)))].join('; ');
const csv = {
  header: [
    'Good', 'Id', 'Category', 'Base price', 'Obsession chance', 'Prestige factor',
    'Trade quantity', 'Convoy cost', 'Producing PMs', 'Consuming PMs',
    'Produced by', 'Used by', 'Pop needs', 'Legacy',
  ],
  rows: goods.map((g) => [
    g.name, g.id, g.category, g.cost, g.obsessionChance || '', g.prestigeFactor || '',
    g.tradedQuantity ?? '', g.convoyCostMultiplier ?? '', g.producers.length, g.consumers.length,
    buildingsOf(g.producers), buildingsOf(g.consumers),
    g.needs.map((n: any) => n.name).join('; '), g.unused ? 'yes' : '',
  ]),
};
---
<Base
  title="Goods"
  active="goods"
  eyebrow="Economy"
  pageFilter="Filter goods…"
  pageStats={[
    { value: goods.length, label: 'goods' },
    { value: categories.length, label: 'categories' },
  ]}
>
  <div class="legends" style="margin: 0 0 0.75rem;">
    <div class="legend">
      <span class="legend__label">Category</span>
      {categories.map((c) => (
        <span class={`chip cat-${c}`}><span class="chip__glyph">●</span>{c}</span>
      ))}
    </div>
  </div>

  <TableTools csvId="goods" csvName="victoria3-goods" />

  <div class="grid">
    <div class="grid__scroll">
      <table class="vtbl" id="goods-table" data-sortable>
        <thead>
          <tr>
            <th>Good</th>
            <th>Category</th>
            <th class="num">Base price</th>
            <th class="num">Obsession</th>
            <th class="num">Prestige</th>
            <th>Produced by</th>
            <th>Used by</th>
            <th>Pop need</th>
          </tr>
        </thead>
        <tbody>
          {goods.map((g) => (
            <tr data-name={`${g.name} ${g.id} ${g.category}`.toLowerCase()}>
              <td class={`lead-cell cat-${g.category}`} data-sort={g.name}>
                <span class="lead">
                  <img class="lead__icon" src={`${base}${g.icon}`} alt="" loading="lazy" />
                  <a href={`${base}goods/${g.slug}`}>{g.name}</a>
                  {g.unused && <span class="chip" title="No production method or pop need references this good">· legacy</span>}
                </span>
              </td>
              <td class="dim">{g.category}</td>
              <td class="num" data-sort={g.cost}>£{g.cost}</td>
              <td class="num" data-sort={g.obsessionChance || ''}>{g.obsessionChance ? `${Math.round(g.obsessionChance * 100)}%` : <span class="cell__dash">—</span>}</td>
              <td class="num" data-sort={g.prestigeFactor || ''}>{g.prestigeFactor || <span class="cell__dash">—</span>}</td>
              <td data-sort={g.producers.length || ''}>{top(g.producers) ?? <span class="cell__dash">—</span>}</td>
              <td data-sort={g.consumers.length || ''}>{top(g.consumers) ?? <span class="cell__dash">—</span>}</td>
              <td>{g.needs.length ? g.needs.map((n: any) => n.name).join(', ') : <span class="cell__dash">—</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p class="caption">Base price from goods.txt · producer/consumer counts span every production method</p>

  <script is:inline define:vars={{ csv }}>
    window.v3Csv = window.v3Csv || {};
    window.v3Csv.goods = () => csv;
  </script>

  <script is:inline>
    const filter = document.getElementById('page-filter');
    if (filter) {
      const rows = [...document.querySelectorAll('#goods-table tbody tr')];
      filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        for (const r of rows) r.classList.toggle('is-hidden', !!q && !r.dataset.name.includes(q));
      });
    }
  </script>
</Base>
