---
import Base from '../layouts/Base.astro';
import TableTools from '../components/TableTools.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  title="Resource Map"
  active="resource-map"
  eyebrow="Tools"
  description="Interactive Victoria 3 resource map: switch between every state resource, or overlay up to three at once to see which dominates and how much is there."
>
  <div class="rm">
    <aside class="rail rm__rail">
      <div>
        <div class="rail__label">
          <span>Layers</span>
          <button type="button" id="rm-clear" class="rail__btn">clear</button>
        </div>
        <p class="rm__note">
          Pick one for a magnitude map. Pick two or three to compare — each gets its own hue and a
          state takes the hue of whichever leads there.
        </p>
        <input id="rm-search" class="rail__select" type="search" placeholder="Find a layer…"
          style="margin-bottom:0.4rem;" />
        <div id="rm-layers" class="rm__layers"></div>
      </div>
    </aside>

    <div class="rm__main">
      <div class="rm__top">
        <div id="rm-legend" class="rm__legend"></div>
        <div class="rm__viewbar">
          <label class="rm__toggle">
            <input type="checkbox" id="rm-labels-cb" /> numbers on map
          </label>
          <label class="rm__toggle">
            shading
            <select id="rm-sqrt" class="rm__sel"
              title="Balanced uses a square-root scale so a typical state stays visible next to the biggest one. On population, a median state reads 16% bright instead of 2%.">
              <option value="sqrt" selected>balanced</option>
              <option value="linear">strictly proportional</option>
            </select>
          </label>
          <span id="rm-labnote" class="rm__hint"></span>
        </div>
      </div>
      <div class="rm__canvaswrap">
        <div id="rm-pan" class="rm__pan">
          <canvas id="rm-canvas" width="2048" height="904"></canvas>
          <div id="rm-labels" class="rm__labels"></div>
        </div>
        <div class="rm__zoom">
          <button type="button" id="rm-zin" title="Zoom in">+</button>
          <button type="button" id="rm-zout" title="Zoom out">−</button>
          <button type="button" id="rm-zreset" title="Reset view">⤢</button>
        </div>
        <div id="rm-tip" class="rm__tip" hidden></div>
      </div>
      <h2 class="sect">Every state, ranked</h2>
      <div class="rm__tablebar">
        <span id="rm-count" class="rm__hint"></span>
        <button type="button" id="rm-csv" class="cp__btn tt__csv" data-csv-id="map"
          data-csv-name="victoria3-resource-map">⤓ Download CSV</button>
      </div>
      <TableTools showBar={false} />
      <div class="grid"><div class="grid__scroll">
        <table class="vtbl" id="rm-table"><thead></thead><tbody></tbody></table>
      </div></div>

      <p class="caption">
        Two kinds of layer. <b>Deposit</b> layers (mines, wharves, arable land, undiscovered finds)
        come from the game's <code>state_regions</code> caps — the maximum levels a state can ever
        hold. <b>Produced</b> layers come from the 1836 setup: the buildings each state starts with,
        at their starting levels, running their activated production methods, so they show where a
        good is actually made on day one rather than where it could be. Hover a state for its full
        breakdown, click to open its <a href={`${base}states`}>location page</a>. Sea, lakes, and the
        106 water regions carry no data. Built by recolouring a state-index map derived from
        <code>provinces.png</code>.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ base }}>
    (async () => {
      const $ = (id) => document.getElementById(id);
      const [meta, idx] = await Promise.all([
        fetch(`${base}data/map.json`).then((r) => r.json()),
        new Promise((res, rej) => {
          const im = new Image();
          im.onload = () => res(im);
          im.onerror = rej;
          im.src = `${base}img/map/states.png`;
        }),
      ]);

      const W = meta.width, H = meta.height;

      // Read the index image once into a plain array of state indices.
      const off = document.createElement('canvas');
      off.width = W; off.height = H;
      const octx = off.getContext('2d', { willReadFrequently: true });
      octx.drawImage(idx, 0, 0);
      const src = octx.getImageData(0, 0, W, H).data;
      const stateAt = new Uint16Array(W * H);
      for (let i = 0, p = 0; i < stateAt.length; i++, p += 4) {
        stateAt[i] = src[p] | (src[p + 1] << 8);
      }

      const canvas = $('rm-canvas');
      const ctx = canvas.getContext('2d');
      const outImg = ctx.createImageData(W, H);

      // ── Palette ──────────────────────────────────────────────────
      // Choropleths compare any two regions, not just neighbours in a legend,
      // so the categorical palette is capped at its three all-pairs-safe slots
      // (validated for this dark surface). Hence: at most three overlays.
      const SERIES = [
        { hex: '#3987e5', name: 'blue' },
        { hex: '#d95926', name: 'orange' },
        { hex: '#199e70', name: 'aqua' },
      ];
      const MAX_LAYERS = SERIES.length;
      // Sequential blue, near-zero closest to the surface (dark) through to
      // bright at the maximum — monotonic lightness on a dark ground.
      const SEQ = ['#0d366b', '#184f95', '#256abf', '#3987e5', '#6da7ec', '#9ec5f4', '#cde2fb'];
      const hexToRgb = (h) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)];
      const SEQ_RGB = SEQ.map(hexToRgb);
      const SERIES_RGB = SERIES.map((s) => hexToRgb(s.hex));
      const WATER = [16, 18, 22];
      const NODATA = [42, 42, 40];

      function ramp(t) {
        const x = Math.max(0, Math.min(1, t)) * (SEQ_RGB.length - 1);
        const i = Math.floor(x), f = x - i;
        const a = SEQ_RGB[i], b = SEQ_RGB[Math.min(i + 1, SEQ_RGB.length - 1)];
        return [a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f, a[2] + (b[2] - a[2]) * f];
      }

      // ── Selection ────────────────────────────────────────────────
      const selected = [];
      const scale = (v, max) => {
        if (max <= 0) return 0;
        // Balanced = square-root. A handful of states hold far more than the
        // rest, so a strictly proportional ramp renders the typical state almost
        // black — on population the median is 2% of the maximum.
        return $('rm-sqrt').value === 'sqrt' ? Math.sqrt(v) / Math.sqrt(max) : v / max;
      };

      // Two different questions live in this list, so they get separate
      // headings: what the ground COULD support, and what is actually being
      // made on the 1836 map.
      const GROUPS = [
        { id: 'deposit', title: 'Can be produced here', sub: 'deposits already on the map',
          match: (l) => l.kind === 'capped' || l.kind === 'arable' },
        { id: 'undiscovered', title: 'Could be found here', sub: 'revealed by prospecting',
          match: (l) => l.kind === 'discoverable' },
        { id: 'produced', title: 'Produced at game start', sub: 'output of the 1836 buildings',
          match: (l) => l.kind === 'good' },
        { id: 'people', title: 'People', sub: '', match: (l) => l.kind === 'pop' },
      ];

      function renderLayers() {
        const q = ($('rm-search').value || '').trim().toLowerCase();
        // Never hide a selected layer, or you cannot switch it off.
        const shown = meta.layers.filter((l) => !q || l.name.toLowerCase().includes(q) || selected.includes(l.key));
        const button = (l) => {
          const at = selected.indexOf(l.key);
          const on = at >= 0;
          const full = selected.length >= MAX_LAYERS && !on;
          return `<button type="button" class="rm__layer ${on ? 'is-on' : ''}" data-key="${l.key}"
                    ${full ? 'disabled title="Three layers is the readable maximum"' : ''}>
            <span class="rm__swatch" style="background:${on ? SERIES[at].hex : 'transparent'}"></span>
            <span class="rm__lname">${l.name.replace(/ (produced|\(undiscovered\))$/, '')}</span>
          </button>`;
        };
        $('rm-layers').innerHTML = GROUPS.map((g) => {
          const items = shown.filter(g.match);
          if (!items.length) return '';
          return `<div class="rm__group">
            <div class="rm__gtitle">${g.title}${g.sub ? `<i>${g.sub}</i>` : ''}</div>
            ${items.map(button).join('')}
          </div>`;
        }).join('');
        $('rm-layers').querySelectorAll('.rm__layer').forEach((b) =>
          b.addEventListener('click', () => {
            const k = b.dataset.key, at = selected.indexOf(k);
            if (at >= 0) selected.splice(at, 1);
            else if (selected.length < MAX_LAYERS) selected.push(k);
            renderLayers(); draw(); renderTable(); renderLabels(); syncHash();
          }));
      }

      function draw() {
        const data = outImg.data;
        if (!selected.length) {
          for (let i = 0, p = 0; i < stateAt.length; i++, p += 4) {
            const c = stateAt[i] ? NODATA : WATER;
            data[p] = c[0]; data[p + 1] = c[1]; data[p + 2] = c[2]; data[p + 3] = 255;
          }
          ctx.putImageData(outImg, 0, 0);
          $('rm-legend').innerHTML = '<span class="rm__hint">Choose a layer to colour the map.</span>';
          return;
        }

        const vals = selected.map((k) => meta.values[k] ?? {});
        // One shared maximum across the chosen layers keeps their intensities
        // comparable — a state that leads in a small resource should not look
        // as loaded as one sitting on a huge deposit.
        let max = 0;
        for (const v of vals) for (const n of Object.values(v)) if (n > max) max = n;

        // Per-state: which layer leads, and the total across the selection.
        const lead = new Uint8Array(676 * 1);
        const total = new Float32Array(700);
        const leadIdx = new Int8Array(700).fill(-1);
        for (let s = 1; s < 700; s++) {
          let best = 0, bestI = -1, sum = 0;
          for (let li = 0; li < vals.length; li++) {
            const n = vals[li][s] ?? 0;
            sum += n;
            if (n > best) { best = n; bestI = li; }
          }
          total[s] = sum; leadIdx[s] = bestI;
        }

        const single = selected.length === 1;
        for (let i = 0, p = 0; i < stateAt.length; i++, p += 4) {
          const s = stateAt[i];
          let c;
          if (!s) c = WATER;
          else if (leadIdx[s] < 0) c = NODATA;
          else if (single) {
            c = ramp(scale(total[s], max));
          } else {
            // Hue says who leads; lightness says how much is there.
            const base = SERIES_RGB[leadIdx[s]];
            const t = 0.25 + 0.75 * scale(total[s], max);
            c = [base[0] * t + NODATA[0] * (1 - t),
                 base[1] * t + NODATA[1] * (1 - t),
                 base[2] * t + NODATA[2] * (1 - t)];
          }
          data[p] = c[0]; data[p + 1] = c[1]; data[p + 2] = c[2]; data[p + 3] = 255;
        }
        ctx.putImageData(outImg, 0, 0);

        $('rm-legend').innerHTML = single
          ? `<div class="rm__lg">
               <span class="rm__lgname">${meta.layers.find((l) => l.key === selected[0]).name}</span>
               <span class="rm__scale">0</span>
               <span class="rm__bar" style="background:linear-gradient(90deg,${SEQ.join(',')})"></span>
               <span class="rm__scale">${max.toLocaleString()} ${meta.layers.find((l) => l.key === selected[0]).unit}</span>
             </div>`
          : `<div class="rm__lg">
               ${selected.map((k, i) => `<span class="rm__key">
                  <span class="rm__swatch" style="background:${SERIES[i].hex}"></span>
                  ${meta.layers.find((l) => l.key === k).name}</span>`).join('')}
               <span class="rm__hint">hue = largest here · brightness = total, up to ${max.toLocaleString()}</span>
             </div>`;
      }

      // ── Zoom, pan and on-map numbers ─────────────────────────────
      const view = { z: 1, x: 0, y: 0 };
      const pan = $('rm-pan');
      const wrap = pan.parentElement;

      function applyView() {
        // Keep the map covering its frame at every zoom level.
        const w = wrap.clientWidth, h = wrap.clientHeight;
        const maxX = w * (view.z - 1), maxY = h * (view.z - 1);
        view.x = Math.min(0, Math.max(-maxX, view.x));
        view.y = Math.min(0, Math.max(-maxY, view.y));
        pan.style.transform = `translate(${view.x}px, ${view.y}px) scale(${view.z})`;
        pan.style.cursor = view.z > 1 ? 'grab' : 'crosshair';
        renderLabels();
      }

      function zoomTo(z, cxFrac = 0.5, cyFrac = 0.5) {
        const prev = view.z;
        view.z = Math.max(1, Math.min(8, Math.round(z * 100) / 100));
        // Keep the point under the cursor (or the centre) fixed.
        const w = wrap.clientWidth, h = wrap.clientHeight;
        const px = cxFrac * w, py = cyFrac * h;
        view.x = px - ((px - view.x) / prev) * view.z;
        view.y = py - ((py - view.y) / prev) * view.z;
        if (view.z === 1) { view.x = 0; view.y = 0; }
        applyView();
        syncHash();
      }

      const compact = (n) =>
        n >= 1e6 ? `${(n / 1e6).toFixed(n >= 1e7 ? 0 : 1)}M`
        : n >= 1e4 ? `${Math.round(n / 1e3)}k`
        : n >= 1e3 ? `${(n / 1e3).toFixed(1)}k`
        : String(Math.round(n));

      function renderLabels() {
        const layer = $('rm-labels');
        layer.innerHTML = '';
        if (!showLabels() || !selected.length) {
          $('rm-labnote').textContent = 'Numbers appear inside states with room for them.';
          return;
        }

        // Biggest deposits get the biggest type, on the same scale the shading
        // uses, so size and brightness tell the same story.
        const vals = selected.map((k) => meta.values[k] ?? {});
        let max = 0;
        for (const v of vals) for (const n of Object.values(v)) if (n > max) max = n;

        // Screen pixels per map pixel, so the fit test is in real pixels.
        const perPx = (wrap.clientWidth / W) * view.z;
        const MIN_PT = 8, MAX_PT = 19;
        let drawn = 0, skipped = 0;
        const html = [];
        for (const [i, st] of Object.entries(meta.states)) {
          const total = selected.reduce((t, k) => t + (meta.values[k]?.[i] ?? 0), 0);
          if (!total) continue;
          const b = meta.bbox[i];
          if (!b || b.cx == null) continue;
          const text = compact(total);
          const pt = MIN_PT + (MAX_PT - MIN_PT) * scale(total, max);
          // Monospace runs about 0.6em wide per character.
          const needW = text.length * pt * 0.6 + 3;
          if ((b.x1 - b.x0) * perPx < needW || (b.y1 - b.y0) * perPx < pt) { skipped++; continue; }
          drawn++;
          html.push(`<span class="rm__lab" style="left:${(b.cx / W) * 100}%;top:${
            (b.cy / H) * 100}%;font-size:${(pt / view.z).toFixed(2)}px">${text}</span>`);
        }
        layer.innerHTML = html.join('');
        $('rm-labnote').textContent = skipped
          ? `${drawn} shown, ${skipped} too small at this zoom — use + to fit more.`
          : `${drawn} shown.`;
      }
      const showLabels = () => $('rm-labels-cb').checked;

      // ── Table under the map ──────────────────────────────────────
      // Same numbers the map is painted from, so the two can never disagree.
      const sort = { col: null, dir: -1 };   // null = by total, descending

      function tableRows() {
        const cols = selected.map((k) => meta.layers.find((l) => l.key === k));
        const out = [];
        for (const [i, st] of Object.entries(meta.states)) {
          const nums = selected.map((k) => meta.values[k]?.[i] ?? 0);
          const total = nums.reduce((a, b) => a + b, 0);
          if (!total) continue;
          out.push({ idx: Number(i), st, nums, total });
        }
        const get = (r) =>
          sort.col === null ? r.total
            : sort.col === 'name' ? r.st.name
            : sort.col === 'region' ? (r.st.region ?? '')
            : r.nums[sort.col];
        out.sort((a, b) => {
          const av = get(a), bv = get(b);
          const c = typeof av === 'number' ? av - bv : String(av).localeCompare(String(bv));
          return (c || a.st.name.localeCompare(b.st.name)) * (typeof av === 'number' ? sort.dir : -sort.dir);
        });
        return { cols, out };
      }

      function renderTable() {
        const { cols, out } = tableRows();
        const table = $('rm-table');
        if (!cols.length) {
          table.tHead.innerHTML = '';
          table.tBodies[0].innerHTML = '';
          $('rm-count').textContent = 'Choose a layer to list states.';
          return;
        }
        const multi = cols.length > 1;
        const arrow = (key) => (sort.col === key ? (sort.dir === -1 ? ' ↓' : ' ↑') : '');
        table.tHead.innerHTML = `<tr>
          <th class="num" style="width:3.5rem;">#</th>
          <th style="min-width:12rem;" class="rm__sort" data-col="name">State${arrow('name')}</th>
          <th style="min-width:10rem;" class="rm__sort" data-col="region">Region${arrow('region')}</th>
          ${cols.map((c, i) => `<th class="num rm__sort" data-col="${i}" title="${c.unit}">${c.name}${arrow(i)}</th>`).join('')}
          ${multi ? `<th class="num rm__sort" data-col="total">Total${arrow(null)}</th>` : ''}</tr>`;
        table.tHead.querySelectorAll('.rm__sort').forEach((th) =>
          th.addEventListener('click', () => {
            const raw = th.dataset.col;
            const col = raw === 'total' ? null : raw === 'name' || raw === 'region' ? raw : Number(raw);
            if (sort.col === col) sort.dir = -sort.dir;
            else { sort.col = col; sort.dir = -1; }
            renderTable();
          }));
        table.tBodies[0].innerHTML = out.map((r, n) => `<tr>
          <td class="num dim">${n + 1}</td>
          <td class="lead-cell" data-sort="${r.st.name}">
            <span class="lead"><a href="${base}locations/${r.st.id.replace('STATE_', '').toLowerCase()}">${r.st.name}</a></span></td>
          <td class="dim">${r.st.region ?? '<span class="cell__dash">—</span>'}</td>
          ${r.nums.map((n2) => `<td class="num">${n2 ? n2.toLocaleString() : '<span class="cell__dash">—</span>'}</td>`).join('')}
          ${multi ? `<td class="num"><b>${r.total.toLocaleString()}</b></td>` : ''}</tr>`).join('');
        table.tBodies[0].querySelectorAll('tr').forEach((tr) => tr.removeAttribute('data-tt-i'));
        $('rm-count').textContent = `${out.length} state${out.length === 1 ? '' : 's'} with ${
          cols.map((c) => c.name).join(' or ')}`;

        window.v3Csv = window.v3Csv || {};
        window.v3Csv.map = () => ({
          header: ['State', 'Id', 'Region', ...cols.map((c) => `${c.name} (${c.unit})`),
                   ...(multi ? ['Total'] : [])],
          rows: out.map((r) => [r.st.name, r.st.id, r.st.region ?? '', ...r.nums,
                                ...(multi ? [r.total] : [])]),
        });
      }

      // ── Hover ────────────────────────────────────────────────────
      const tip = $('rm-tip');
      canvas.addEventListener('mousemove', (e) => {
        const r = canvas.getBoundingClientRect();
        const x = Math.floor((e.clientX - r.left) / r.width * W);
        const y = Math.floor((e.clientY - r.top) / r.height * H);
        if (x < 0 || y < 0 || x >= W || y >= H) return;
        const s = stateAt[y * W + x];
        const st = meta.states[s];
        if (!st) { tip.hidden = true; return; }
        const rows = meta.layers
          .map((l) => ({ l, n: meta.values[l.key]?.[s] ?? 0 }))
          .filter((r) => r.n > 0)
          .sort((a, b) => b.n - a.n);
        tip.innerHTML = `<b>${st.name}</b>${st.region ? `<i>${st.region}</i>` : ''}
          ${rows.length
            ? `<table>${rows.map((r) => `<tr><td>${r.l.name}</td><td>${r.n.toLocaleString()}</td>` +
                `<td class="rm__unit">${r.l.unit}</td></tr>`).join('')}</table>`
            : '<span class="rm__hint">no mapped resources</span>'}`;
        tip.hidden = false;
        tip.style.left = `${e.clientX - r.left + 14}px`;
        tip.style.top = `${e.clientY - r.top + 14}px`;
      });
      canvas.addEventListener('mouseleave', () => { tip.hidden = true; });
      canvas.addEventListener('click', (e) => {
        if (drag && drag.moved) return;   // that was a pan, not a pick
        const r = canvas.getBoundingClientRect();
        const x = Math.floor((e.clientX - r.left) / r.width * W);
        const y = Math.floor((e.clientY - r.top) / r.height * H);
        const st = meta.states[stateAt[y * W + x]];
        if (st) location.href = `${base}states#${st.id}`;
      });

      function syncHash() {
        const parts = [];
        if (selected.length) parts.push(`l=${selected.join(',')}`);
        if ($('rm-labels-cb').checked) parts.push('labels=1');
        if (view.z > 1) parts.push(`z=${view.z}`);
        history.replaceState(null, '', parts.length ? `#${parts.join('&')}` : location.pathname);
      }
      $('rm-sqrt').addEventListener('change', () => { draw(); renderLabels(); });
      $('rm-labels-cb').addEventListener('change', () => { renderLabels(); syncHash(); });
      $('rm-zin').addEventListener('click', () => zoomTo(view.z * 1.6));
      $('rm-zout').addEventListener('click', () => zoomTo(view.z / 1.6));
      $('rm-zreset').addEventListener('click', () => { view.z = 1; view.x = 0; view.y = 0; applyView(); });
      canvas.addEventListener('dblclick', (e) => {
        const r = wrap.getBoundingClientRect();
        zoomTo(view.z * 1.8, (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
      });
      // Drag to pan once zoomed in.
      let drag = null;
      pan.addEventListener('pointerdown', (e) => {
        if (view.z === 1) return;
        drag = { x: e.clientX, y: e.clientY, ox: view.x, oy: view.y, moved: false };
        pan.setPointerCapture(e.pointerId);
        pan.style.cursor = 'grabbing';
      });
      pan.addEventListener('pointermove', (e) => {
        if (!drag) return;
        view.x = drag.ox + (e.clientX - drag.x);
        view.y = drag.oy + (e.clientY - drag.y);
        if (Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y) > 3) drag.moved = true;
        applyView();
      });
      pan.addEventListener('pointerup', (e) => {
        if (drag) { pan.releasePointerCapture(e.pointerId); }
        pan.style.cursor = view.z > 1 ? 'grab' : 'crosshair';
        setTimeout(() => { drag = null; }, 0);
      });
      // Trackpad pinch. macOS Chrome/Firefox report a pinch as a wheel event
      // with ctrlKey set; a plain two-finger scroll has it clear and must be
      // left alone so the page still scrolls.
      wrap.addEventListener('wheel', (e) => {
        if (!e.ctrlKey) return;
        e.preventDefault();
        const r = wrap.getBoundingClientRect();
        zoomTo(view.z * Math.exp(-e.deltaY * 0.01),
               (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
      }, { passive: false });

      // Safari sends its own gesture events instead.
      let gestureStart = 1;
      wrap.addEventListener('gesturestart', (e) => { e.preventDefault(); gestureStart = view.z; });
      wrap.addEventListener('gesturechange', (e) => {
        e.preventDefault();
        const r = wrap.getBoundingClientRect();
        zoomTo(gestureStart * e.scale,
               (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
      });
      wrap.addEventListener('gestureend', (e) => e.preventDefault());

      window.addEventListener('resize', renderLabels);
      $('rm-clear').addEventListener('click', () => {
        selected.length = 0; renderLayers(); draw(); renderTable(); syncHash();
      });

      // A map view in the URL, so a layer set can be linked to.
      const hash = new URLSearchParams(location.hash.slice(1));
      const fromHash = hash.get('l');
      const wanted = fromHash
        ? fromHash.split(',').filter((k) => meta.layers.some((l) => l.key === k)).slice(0, MAX_LAYERS)
        : [(meta.layers.find((l) => /iron/i.test(l.name)) ?? meta.layers[0]).key];
      selected.push(...wanted);
      $('rm-search').addEventListener('input', renderLayers);
      if (hash.get('labels') === '1') $('rm-labels-cb').checked = true;
      const hz = Number(hash.get('z'));
      if (hz > 1) view.z = Math.min(8, hz);
      renderLayers();
      draw();
      renderTable();
      applyView();
    })();
  </script>

  <style is:global>
    .rm { display: grid; grid-template-columns: minmax(13rem, 16rem) 1fr; gap: 1.4rem; align-items: start; }
    @media (max-width: 900px) { .rm { grid-template-columns: 1fr; } }
    .rm__note { font-size: 0.7rem; color: var(--text-faint); margin: 0.25rem 0 0.5rem; line-height: 1.45; }
    .rm__layers { display: flex; flex-direction: column; gap: 0.1rem; }
    .rm__group { display: flex; flex-direction: column; gap: 0.05rem; margin-bottom: 0.5rem; }
    .rm__gtitle {
      font-family: var(--font-ui); font-size: 0.58rem; text-transform: uppercase;
      letter-spacing: 0.14em; color: var(--gold-soft); font-weight: 500;
      border-bottom: 1px solid var(--border); padding-bottom: 0.15rem; margin-bottom: 0.2rem;
    }
    .rm__gtitle i {
      display: block; font-style: normal; text-transform: none; letter-spacing: 0.01em;
      color: var(--text-faint); font-size: 0.62rem;
    }
    .rm__layer {
      display: flex; align-items: center; gap: 0.45rem;
      background: none; border: 0; cursor: pointer; font: inherit; font-size: 0.78rem;
      color: var(--text-dim); text-align: left; padding: 0.22rem 0.3rem; border-radius: 4px;
    }
    .rm__layer:hover:not(:disabled) { background: var(--bg-elev); color: var(--text); }
    .rm__layer.is-on { color: var(--text); background: var(--bg-elev); }
    .rm__layer:disabled { opacity: 0.35; cursor: not-allowed; }
    .rm__swatch {
      width: 11px; height: 11px; border-radius: 3px; flex-shrink: 0;
      border: 1px solid var(--border-strong);
    }
    .rm__toggle {
      display: inline-flex; align-items: center; gap: 0.35rem;
      font-size: 0.76rem; color: var(--text-dim); cursor: pointer;
    }
    .rm__toggle input { accent-color: var(--gold); margin: 0; }
    .rm__sel {
      background: var(--bg-elev); color: var(--text); border: 1px solid var(--border);
      border-radius: 5px; font: inherit; font-size: 0.74rem; padding: 0.1rem 0.25rem;
    }

    .rm__canvaswrap {
      position: relative; border: 1px solid var(--border); border-radius: 8px;
      overflow: hidden; touch-action: none;
    }
    .rm__pan { transform-origin: 0 0; position: relative; will-change: transform; }
    .rm__labels { position: absolute; inset: 0; pointer-events: none; }
    .rm__lab {
      position: absolute; transform: translate(-50%, -50%);
      font-family: var(--font-mono); font-weight: 500; line-height: 1;
      color: #fff; text-shadow: 0 0 2px #000, 0 0 3px #000, 0 1px 2px #000;
      white-space: nowrap;
    }
    .rm__zoom {
      position: absolute; top: 0.5rem; right: 0.5rem; z-index: 4;
      display: flex; flex-direction: column; gap: 0.2rem;
    }
    .rm__zoom button {
      width: 1.8rem; height: 1.8rem; font: inherit; font-size: 0.9rem; cursor: pointer;
      background: color-mix(in srgb, var(--bg-elev) 88%, transparent);
      border: 1px solid var(--border-strong); color: var(--text);
      border-radius: 5px; line-height: 1;
    }
    .rm__zoom button:hover { border-color: var(--gold-deep); color: var(--gold); }
    .rm__canvaswrap canvas {
      display: block; width: 100%; height: auto;
      image-rendering: auto; cursor: crosshair; background: #101216;
    }
    .rm__top {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem;
    }
    .rm__viewbar { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }
    .rm__legend { min-height: 1.6rem; }
    .rm__lg { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; font-size: 0.76rem; }
    .rm__lgname { color: var(--text); font-weight: 500; }
    .rm__key { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text-soft); }
    .rm__bar { width: 12rem; height: 9px; border-radius: 3px; display: inline-block; }
    .rm__scale { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-faint); }
    .rm__hint { font-size: 0.72rem; color: var(--text-faint); }

    .rm__sort { cursor: pointer; user-select: none; }
    .rm__sort:hover { color: var(--gold); }
    .rm__tablebar { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
    .rm__tip {
      position: absolute; z-index: 5; pointer-events: none;
      background: var(--bg-elev); border: 1px solid var(--border-strong);
      border-radius: 6px; padding: 0.4rem 0.55rem; font-size: 0.75rem;
      box-shadow: 0 8px 24px rgba(0,0,0,0.5); max-width: 16rem;
    }
    .rm__tip[hidden] { display: none; }
    .rm__tip b { display: block; font-size: 0.82rem; }
    .rm__tip i { display: block; font-style: normal; color: var(--text-faint); font-size: 0.66rem; margin-bottom: 0.2rem; }
    .rm__tip table { border-collapse: collapse; margin-top: 0.15rem; }
    .rm__tip td { padding: 0.04rem 0; color: var(--text-soft); }
    .rm__tip .rm__unit {
      color: var(--text-faint); font-size: 0.62rem; padding-left: 0.4rem;
      text-align: left; font-variant-numeric: normal;
    }
    .rm__tip td:nth-child(2) { text-align: right; padding-left: 0.8rem; font-variant-numeric: tabular-nums; color: var(--text); }
  </style>
</Base>
