---
import Base from '../layouts/Base.astro';
import { TABS, SECTIONS } from '../data/tabs';

const base = import.meta.env.BASE_URL;
const built = TABS.filter(t => t.status === 'built').length;
const sections = SECTIONS
  .map(section => ({ section, items: TABS.filter(t => t.section === section && t.status !== 'skipped') }))
  .filter(s => s.items.length > 0);
---
<Base
  title="Victoria 3 Reference"
  eyebrow="Every number, from the game's own files"
  pageStats={[
    { value: built, label: 'pages built' },
    { value: TABS.length - built, label: 'planned' },
  ]}
>
  <div class="cards">
    {sections.map(({ section, items }) => (
      <>
        <div class="cards__section">{section}</div>
        {items.map(t =>
          t.status === 'built' ? (
            <a class="card" href={`${base}${t.slug}`}>
              <span class="card__title"><span class="card__icon">{t.icon}</span>{t.label}</span>
              <span class="card__sum">{t.summary}</span>
            </a>
          ) : (
            <div class="card card--soon">
              <span class="card__title"><span class="card__icon">{t.icon}</span>{t.label}</span>
              <span class="card__sum">{t.summary}</span>
              <span class="card__soon">planned</span>
            </div>
          ),
        )}
      </>
    ))}
  </div>
</Base>
