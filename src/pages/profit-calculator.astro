---
import Base from '../layouts/Base.astro';
import TableTools from '../components/TableTools.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  title="Profit Calculator"
  active="profit-calculator"
  eyebrow="Tools"
  description="Compare every Victoria 3 production method at your own market prices: per building, per group, ranked, with per-worker and per-construction returns."
  pageStats={[{ value: 'per level', label: 'at full employment' }]}
>
  <div class="pc__top">
    <label class="pc__field">
      <span class="pc__label">Building</span>
      <select id="pc-building" class="pc__select"><option>Loading…</option></select>
    </label>
    <div class="pc__pricebox">
      <span class="pc__label">Market prices — drag to model your market (±75% of base)</span>
      <div id="pc-prices"></div>
    </div>
  </div>

  <div id="pc-summary" class="pc__summary"></div>

  <h2 class="sect">Every combination, ranked at these prices</h2>
  <p class="pc__hint">
    Every combination the building can run, ranked. In the current game data every goods line is a flat
    amount — there are no percentage goods modifiers — so the groups do not interact and the best option
    in each group always combines into the best overall set (checked exhaustively against 19,200
    building × random-market cases). This view is here to show the whole trade-off space, not to correct
    the per-group one. Click a row to load it.
  </p>
  <div class="pc__cmbbar">
    <span id="pc-cmb-count" class="pc__hint" style="margin:0;"></span>
    <label class="pc__toggle"><input type="checkbox" id="pc-cmb-all" /> show all</label>
  </div>
  <div class="grid"><div class="grid__scroll">
    <table class="vtbl" id="pc-cmb"><thead></thead><tbody></tbody></table>
  </div></div>
  <p class="caption">
    Ranked on production margin only. Wages scale with employment and are not modeled, so a
    higher-net combination that employs far more people is not automatically better — read the
    £/worker column alongside the net.
  </p>

  <h2 class="sect">Each group on its own</h2>
  <p class="pc__hint">
    One block per production-method group — you run one method from each. Every option shows what the
    <em>whole building</em> would earn if you picked it, holding your other groups fixed.
    <b class="tone-good">Best</b> is marked; the delta is what switching to it would gain or cost you.
    Automation methods read as a lower net because they buy the same output with fewer workers — the
    saving is in wages, which this does not price. Click a row to select it.
  </p>
  <div id="pc-groups" class="pc__groups"></div>

  <p class="caption">
    Revenue − input costs at your prices, per building level at full employment. This is the goods
    margin: it counts every goods line and every employment line in the game's production methods, and
    nothing else. Methods also carry effects this cannot price — mortality, shares, job attractiveness,
    minimum wage, training rate — and wages, economy of scale, and state throughput bonuses are not
    modeled. 64 of the game's 97 buildings appear here; the rest (monuments, financial districts,
    ownership-only buildings) move no goods.
  </p>

  <TableTools showBar={false} />

  <h2 class="sect" id="compare">Compare across all buildings</h2>
  <p class="pc__hint">
    Each row is one method's own goods flow at the prices above. Sort by per-worker or per-construction
    to find where a wage or a point of construction buys the most output.
  </p>
  <div class="pc__cmpbar">
    <label class="pc__field pc__field--inline">
      <span class="pc__label">Filter</span>
      <input id="pc-cmp-filter" type="search" class="pc__select" placeholder="Building, method, or good…" />
    </label>
    <label class="pc__toggle">
      <input type="checkbox" id="pc-cmp-positive" /> only profitable
    </label>
    <span id="pc-cmp-count" class="pc__hint" style="margin:0;"></span>
  </div>
  <div class="grid"><div class="grid__scroll">
    <table class="vtbl" id="pc-cmp" data-sortable>
      <thead>
        <tr>
          <th style="min-width: 12rem;">Building</th>
          <th style="min-width: 12rem;">Production method</th>
          <th class="num" title="Revenue − input cost at your prices, per building level">Net £/level</th>
          <th class="num" title="Jobs this method adds per level">Workers</th>
          <th class="num" title="Net £ per worker employed">£/worker</th>
          <th class="num" title="Construction points the building costs">Construction</th>
          <th class="num" title="Net £ per point of construction — the payback on building it">£/construction</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div></div>
  <p class="caption">
    Per-method values here: that method's own goods and jobs, independent of the rest of the building
  </p>

  <script is:inline define:vars={{ base }}>
    (async () => {
      const data = await fetch(`${base}data/profit-calc.json`).then((r) => r.json());
      const $ = (id) => document.getElementById(id);
      const state = { building: null, choice: {}, price: {} };
      const priceOf = (g) => (data.goods[g]?.cost ?? 0) * (1 + (state.price[g] ?? 0) / 100);

      // ── Core model ─────────────────────────────────────────────────
      // Aggregate a building's flows for a given set of PM choices.
      // `add` lines sum; `mult` lines scale that good's total, which is why a
      // method's worth can only be judged alongside the rest of the building.
      function evaluate(choice) {
        const flow = {}, mult = {}, jobs = {};
        for (const [gi, pi] of Object.entries(choice)) {
          const pm = state.building.pmGroups[gi]?.pms[pi];
          if (!pm) continue;
          for (const l of pm.inputs) {
            if (l.k === 'add') flow[l.g] = (flow[l.g] ?? 0) - l.a;
            else (mult[l.g] ??= { in: 0, out: 0 }).in += l.a;
          }
          for (const l of pm.outputs) {
            if (l.k === 'add') flow[l.g] = (flow[l.g] ?? 0) + l.a;
            else (mult[l.g] ??= { in: 0, out: 0 }).out += l.a;
          }
          for (const j of pm.jobs) jobs[j.p] = (jobs[j.p] ?? 0) + j.a;
        }
        for (const [g, m] of Object.entries(mult)) {
          if (flow[g] != null) flow[g] *= 1 + (flow[g] > 0 ? m.out : m.in);
        }
        let net = 0;
        for (const [g, units] of Object.entries(flow)) net += units * priceOf(g);
        return { flow, jobs, net, totalJobs: Object.values(jobs).reduce((s, a) => s + a, 0) };
      }

      // What the building would earn with one group switched to `pi`.
      const evaluateWith = (gi, pi) => evaluate({ ...state.choice, [gi]: pi });

      // ── Building picker ────────────────────────────────────────────
      const buildingSel = $('pc-building');
      buildingSel.innerHTML = '';
      let lastGroup = null, optgroup = null;
      for (const b of data.buildings) {
        if (b.group !== lastGroup) {
          optgroup = document.createElement('optgroup');
          optgroup.label = b.group ?? 'Other';
          buildingSel.appendChild(optgroup);
          lastGroup = b.group;
        }
        const o = document.createElement('option');
        o.value = b.id;
        o.textContent = b.name;
        optgroup.appendChild(o);
      }

      function pickBuilding(id) {
        state.building = data.buildings.find((b) => b.id === id);
        state.choice = {};
        state.building.pmGroups.forEach((g, gi) => { if (g.pms.length) state.choice[gi] = 0; });
        state.priceRowsFor = null; // force the price rows to rebuild for this building
        render();
      }

      // ── Prices ─────────────────────────────────────────────────────
      // Rebuild the ROWS only when the set of goods changes: re-creating a
      // slider mid-drag destroys the element the browser is tracking, which
      // reads as "click to step" instead of dragging.
      function renderPriceRows() {
        // Every good the building could touch under ANY choice, so the slider
        // set stays put while you compare options.
        const involved = new Set();
        for (const g of state.building.pmGroups) {
          for (const pm of g.pms) {
            for (const l of [...pm.inputs, ...pm.outputs]) if (l.k === 'add') involved.add(l.g);
          }
        }
        const list = [...involved].sort((a, b) => data.goods[a].name.localeCompare(data.goods[b].name));
        const signature = list.join('|');
        if (signature === state.priceRowsFor) return;
        state.priceRowsFor = signature;

        const prices = $('pc-prices');
        prices.innerHTML = '';
        for (const g of list) {
          if (state.price[g] == null) state.price[g] = 0; // % offset from base
          const good = data.goods[g];
          const row = document.createElement('div');
          row.className = 'pc__price';
          row.innerHTML = `
            <img src="${base}${good.icon}" alt="" loading="lazy" />
            <span class="pc__pname">${good.name}</span>
            <input type="range" min="-75" max="75" step="5" value="${state.price[g]}" data-good="${g}" />
            <span class="pc__pval" data-val="${g}"></span>`;
          row.querySelector('input').addEventListener('input', (e) => {
            state.price[g] = Number(e.target.value);
            renderPriceLabels();
            renderSummary();
            renderGroups();
            renderCombinations();
            renderCompare();
          });
          prices.appendChild(row);
        }
        renderPriceLabels();
      }

      function renderPriceLabels() {
        for (const el of document.querySelectorAll('[data-val]')) {
          const g = el.dataset.val;
          const pct = state.price[g] ?? 0;
          el.innerHTML = `£${priceOf(g).toFixed(1)} <i>(${pct >= 0 ? '+' : ''}${pct}%)</i>`;
        }
      }

      // ── Summary ────────────────────────────────────────────────────
      function renderSummary() {
        const { flow, jobs, net, totalJobs } = evaluate(state.choice);
        const lines = Object.entries(flow)
          .filter(([, u]) => u !== 0)
          .map(([g, units]) => ({ name: data.goods[g].name, icon: data.goods[g].icon, units, value: units * priceOf(g) }))
          .sort((a, b) => b.value - a.value);
        $('pc-summary').innerHTML = `
          <div class="pc__net ${net >= 0 ? 'tone-good' : 'tone-bad'}">£${net.toFixed(0)} <span>net / level</span></div>
          <table class="vtbl pc__table"><tbody>
            ${lines.map((l) => `<tr>
              <td class="lead-cell"><span class="lead"><img class="lead__icon" src="${base}${l.icon}" alt="" />${l.name}</span></td>
              <td class="num">${l.units > 0 ? '+' : ''}${Number(l.units.toFixed(1))}</td>
              <td class="num ${l.value >= 0 ? 'tone-good' : 'tone-bad'}">£${l.value.toFixed(0)}</td>
            </tr>`).join('')}
            <tr><td class="lead-cell"><span class="lead">Employment</span></td>
              <td class="num" colspan="2">${Object.entries(jobs).map(([p, a]) => `${p} ${a}`).join(' · ') || '—'} (${totalJobs})</td></tr>
          </tbody></table>`;
      }

      // ── Ranked options, one block per PM group ─────────────────────
      function renderGroups() {
        const wrap = $('pc-groups');
        wrap.innerHTML = '';
        state.building.pmGroups.forEach((g, gi) => {
          if (!g.pms.length) return;
          const current = state.choice[gi];
          const currentNet = evaluateWith(gi, current).net;
          const options = g.pms.map((pm, pi) => {
            const r = evaluateWith(gi, pi);
            return {
              pi, pm, net: r.net, jobs: r.totalJobs, delta: r.net - currentNet,
              // Why an automation option can be right despite a lower net: it
              // buys the same output with fewer workers.
              perWorker: r.totalJobs > 0 ? r.net / r.totalJobs : null,
            };
          });
          const best = Math.max(...options.map((o) => o.net));
          // Rank by value, but keep it stable so equal options don't jump around.
          const ranked = [...options].sort((a, b) => b.net - a.net || a.pi - b.pi);

          const block = document.createElement('div');
          block.className = 'pc__group';
          block.innerHTML = `
            <div class="pc__gname">${g.name}</div>
            <table class="vtbl pc__gtable">
              <thead><tr>
                <th>Method</th><th class="num">Net £</th><th class="num">vs current</th>
                <th class="num" title="Total jobs in the building with this option">Jobs</th>
                <th class="num" title="Net £ per worker with this option">£/wkr</th>
              </tr></thead>
              <tbody>
              ${ranked.map((o) => `
                <tr class="pc__opt ${o.pi === current ? 'is-current' : ''} ${o.net === best ? 'is-best' : ''}"
                    data-gi="${gi}" data-pi="${o.pi}">
                  <td class="pc__optname">
                    <img src="${base}${o.pm.icon ?? ''}" alt="" loading="lazy"
                         onerror="this.style.visibility='hidden'" />
                    ${o.pm.name}
                    ${o.net === best ? '<span class="pc__badge">best</span>' : ''}
                  </td>
                  <td class="num"><b class="${o.net >= 0 ? 'tone-good' : 'tone-bad'}">£${o.net.toFixed(0)}</b></td>
                  <td class="num pc__delta">${
                    o.pi === current
                      ? '<span class="pc__cur">current</span>'
                      : `<span class="${o.delta > 0 ? 'tone-good' : o.delta < 0 ? 'tone-bad' : 'tone-neutral'}">${
                          o.delta > 0 ? '+' : ''}£${o.delta.toFixed(0)}</span>`
                  }</td>
                  <td class="num dim" title="Total jobs in the building with this option">${o.jobs}</td>
                  <td class="num dim" title="Net £ per worker — how much each job carries with this option">${
                    o.perWorker == null ? '<span class="cell__dash">—</span>' : o.perWorker.toFixed(2)
                  }</td>
                </tr>`).join('')}
            </tbody></table>`;
          wrap.appendChild(block);
        });

        wrap.querySelectorAll('.pc__opt').forEach((tr) =>
          tr.addEventListener('click', () => {
            state.choice[tr.dataset.gi] = Number(tr.dataset.pi);
            renderSummary();
            renderGroups();
            renderCombinations();
          }));
      }

      // ── Every combination the building can run ─────────────────────
      // The cartesian product over PM groups. The space is small (108 at the
      // widest, Livestock Ranches), so rank exhaustively rather than assuming
      // the per-group winners combine into the best set — with percentage
      // methods in play they often do not.
      function allCombinations() {
        const groups = state.building.pmGroups
          .map((g, gi) => ({ gi, g }))
          .filter(({ g }) => g.pms.length);
        let combos = [{}];
        for (const { gi, g } of groups) {
          const next = [];
          for (const c of combos) for (let pi = 0; pi < g.pms.length; pi++) next.push({ ...c, [gi]: pi });
          combos = next;
        }
        return { groups, combos };
      }

      function renderCombinations() {
        const { groups, combos } = allCombinations();
        const scored = combos.map((choice) => {
          const r = evaluate(choice);
          return {
            choice,
            net: r.net,
            jobs: r.totalJobs,
            perWorker: r.totalJobs > 0 ? r.net / r.totalJobs : null,
          };
        }).sort((a, b) => b.net - a.net);

        const showAll = $('pc-cmb-all').checked;
        const shown = showAll ? scored : scored.slice(0, 12);
        const same = (c) => groups.every(({ gi }) => c[gi] === state.choice[gi]);

        $('pc-cmb').tHead.innerHTML = `<tr>
          <th class="num" style="width:3rem;">#</th>
          ${groups.map(({ g }) => `<th>${g.name}</th>`).join('')}
          <th class="num">Net £</th><th class="num">Jobs</th><th class="num">£/wkr</th></tr>`;
        $('pc-cmb').tBodies[0].innerHTML = shown.map((r, i) => {
          const rank = scored.indexOf(r) + 1;
          return `<tr class="pc__opt ${same(r.choice) ? 'is-current' : ''}" data-combo="${
            groups.map(({ gi }) => `${gi}:${r.choice[gi]}`).join(',')}">
            <td class="num dim">${rank}</td>
            ${groups.map(({ gi, g }) => `<td>${g.pms[r.choice[gi]].name}</td>`).join('')}
            <td class="num"><b class="${r.net >= 0 ? 'tone-good' : 'tone-bad'}">£${r.net.toFixed(0)}</b></td>
            <td class="num dim">${r.jobs}</td>
            <td class="num dim">${r.perWorker == null ? '<span class="cell__dash">—</span>' : r.perWorker.toFixed(2)}</td>
          </tr>`;
        }).join('');
        $('pc-cmb-count').textContent = showAll
          ? `all ${scored.length} combinations`
          : `top 12 of ${scored.length} combinations`;

        $('pc-cmb').tBodies[0].querySelectorAll('tr').forEach((tr) =>
          tr.addEventListener('click', () => {
            for (const part of tr.dataset.combo.split(',')) {
              const [gi, pi] = part.split(':');
              state.choice[gi] = Number(pi);
            }
            renderSummary();
            renderGroups();
            renderCombinations();
          }));
      }

      function render() {
        renderPriceRows();
        renderSummary();
        renderGroups();
        renderCombinations();
        renderCompare();
      }

      // ── Compare across all buildings ───────────────────────────────
      const rows = [];
      for (const b of data.buildings) {
        for (const g of b.pmGroups) {
          for (const pm of g.pms) {
            if (!pm.inputs.length && !pm.outputs.length) continue; // pure % methods
            rows.push({
              b, pm,
              jobs: pm.jobs.reduce((s, j) => s + j.a, 0),
              search: `${b.name} ${g.name} ${pm.name} ${[...pm.inputs, ...pm.outputs]
                .map((l) => data.goods[l.g]?.name ?? l.g).join(' ')}`.toLowerCase(),
            });
          }
        }
      }
      const money = (lines, sign) =>
        lines.filter((l) => l.k === 'add').reduce((s, l) => s + sign * l.a * priceOf(l.g), 0);

      function renderCompare() {
        const q = $('pc-cmp-filter').value.trim().toLowerCase();
        const onlyPositive = $('pc-cmp-positive').checked;
        const body = $('pc-cmp').tBodies[0];
        const out = [];
        for (const r of rows) {
          if (q && !r.search.includes(q)) continue;
          const net = money(r.pm.outputs, 1) + money(r.pm.inputs, -1);
          if (onlyPositive && net <= 0) continue;
          // Automation methods REMOVE jobs; a negative net over negative workers
          // yields a cheerful positive ratio that means nothing.
          const perWorker = r.jobs > 0 ? net / r.jobs : null;
          const perConstruction = r.b.construction ? net / r.b.construction : null;
          const tone = (v) => (v > 0 ? 'tone-good' : v < 0 ? 'tone-bad' : 'tone-neutral');
          const num = (v, d = 0) => (v == null ? '<span class="cell__dash">—</span>' : v.toFixed(d));
          out.push({ sort: [r.b.name, r.pm.name, net, r.jobs, perWorker, r.b.construction, perConstruction], html: `<tr>
            <td class="lead-cell" data-sort="${r.b.name}">
              <span class="lead"><img class="lead__icon" src="${base}${r.b.icon}" alt="" loading="lazy" />
              <a href="${base}buildings/${r.b.id.replace('building_', '')}">${r.b.name}</a></span></td>
            <td>${r.pm.name}</td>
            <td class="num" data-sort="${net.toFixed(2)}"><b class="${tone(net)}">£${net.toFixed(0)}</b></td>
            <td class="num" data-sort="${r.jobs || ''}">${r.jobs || '<span class="cell__dash">—</span>'}</td>
            <td class="num" data-sort="${perWorker ?? ''}"><span class="${perWorker == null ? '' : tone(perWorker)}">${num(perWorker, 3)}</span></td>
            <td class="num dim" data-sort="${r.b.construction ?? ''}">${r.b.construction ?? '<span class="cell__dash">—</span>'}</td>
            <td class="num" data-sort="${perConstruction ?? ''}"><span class="${perConstruction == null ? '' : tone(perConstruction)}">${num(perConstruction, 2)}</span></td>
          </tr>` });
        }

        // Re-apply the table's active sort: TableTools sorts the live DOM, and
        // we just replaced every row, so a price nudge would otherwise drop the
        // user back to build order.
        const heads = [...$('pc-cmp').tHead.rows[0].cells];
        const col = heads.findIndex((th) => (th.getAttribute('aria-sort') ?? 'none') !== 'none');
        if (col >= 0) {
          const dir = heads[col].getAttribute('aria-sort') === 'ascending' ? 1 : -1;
          out.sort((a, b) => {
            const av = a.sort[col], bv = b.sort[col];
            if (av == null && bv == null) return 0;
            if (av == null) return 1;   // blanks sink in both directions
            if (bv == null) return -1;
            return (typeof av === 'number' ? av - bv : String(av).localeCompare(String(bv))) * dir;
          });
        }
        body.innerHTML = out.map((r) => r.html).join('');
        $('pc-cmp-count').textContent = `${out.length} of ${rows.length} methods`;
        body.querySelectorAll('tr').forEach((tr) => tr.removeAttribute('data-tt-i'));
      }

      $('pc-cmb-all').addEventListener('change', renderCombinations);
      $('pc-cmp-filter').addEventListener('input', renderCompare);
      $('pc-cmp-positive').addEventListener('change', renderCompare);
      buildingSel.addEventListener('change', () => pickBuilding(buildingSel.value));
      pickBuilding(data.buildings[0].id);
    })();
  </script>

  <style is:global>
    .pc__top {
      display: grid; grid-template-columns: minmax(14rem, 20rem) 1fr;
      gap: 1.5rem; align-items: start; margin-bottom: 1rem;
    }
    @media (max-width: 900px) { .pc__top { grid-template-columns: 1fr; } }
    .pc__field { display: flex; flex-direction: column; gap: 0.25rem; }
    .pc__label {
      font-family: var(--font-ui); font-size: 0.62rem; text-transform: uppercase;
      letter-spacing: 0.16em; color: var(--gold-soft); font-weight: 500;
    }
    .pc__select {
      background: var(--bg-elev); color: var(--text);
      border: 1px solid var(--border); border-radius: 6px;
      font: inherit; font-size: 0.85rem; padding: 0.4rem 0.5rem;
    }
    .pc__pricebox { display: flex; flex-direction: column; gap: 0.3rem; }
    .pc__hint { font-size: 0.76rem; color: var(--text-dim); margin: 0 0 0.7rem; max-width: 62rem; line-height: 1.5; }
    .pc__price {
      display: grid; grid-template-columns: 20px 8rem minmax(6rem, 22rem) 8rem;
      gap: 0.6rem; align-items: center; font-size: 0.8rem;
    }
    .pc__price img { width: 18px; height: 18px; object-fit: contain; }
    .pc__price input { accent-color: var(--gold); }
    .pc__pval { font-variant-numeric: tabular-nums; }
    .pc__pval i { color: var(--text-faint); font-style: normal; font-size: 0.72rem; }

    .pc__net { font-family: var(--font-display); font-size: 2rem; margin: 0.2rem 0 0.5rem; }
    .pc__net span { font-size: 0.9rem; color: var(--text-dim); font-family: var(--font-ui); }
    .pc__table { max-width: 34rem; }

    .pc__groups {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(25rem, 1fr));
      gap: 0.5rem 1.5rem; align-items: start;
    }
    .pc__gname {
      font-family: var(--font-ui); font-size: 0.62rem; text-transform: uppercase;
      letter-spacing: 0.16em; color: var(--gold-soft); font-weight: 500;
      border-bottom: 1px solid var(--border); padding-bottom: 0.2rem; margin-bottom: 0.1rem;
    }
    .pc__gtable { margin-bottom: 0.8rem; }
    .pc__gtable thead th {
      position: static; border-bottom: 1px solid var(--border);
      font-size: 0.55rem; letter-spacing: 0.1em; padding: 0.2rem 0.5rem;
    }
    .pc__opt { cursor: pointer; }
    .pc__opt:hover td { background: oklch(0.30 0.04 80 / 0.3); }
    .pc__opt td { padding: 0.24rem 0.5rem; }
    .pc__optname {
      display: flex; align-items: center; gap: 0.4rem;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .pc__optname img { width: 18px; height: 18px; object-fit: contain; flex-shrink: 0; }
    .pc__opt.is-best td { box-shadow: inset 0 0 0 0 transparent; }
    .pc__opt.is-best .pc__optname { color: var(--text); }
    .pc__opt.is-current td:first-child { box-shadow: inset 3px 0 0 var(--gold); }
    .pc__opt.is-current { background: var(--bg-elev); }
    .pc__badge {
      font-family: var(--font-mono); font-size: 0.54rem; text-transform: uppercase;
