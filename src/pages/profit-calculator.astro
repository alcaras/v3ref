---
import Base from '../layouts/Base.astro';
import PriceRail from '../components/PriceRail.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  title="Building Profit"
  active="profit-calculator"
  eyebrow="Tools"
  description="What one Victoria 3 building earns per level at your market prices, with every production method in every group ranked in place."
>
  <div class="bp">
    <aside class="rail">
      <div>
        <div class="rail__label">Building</div>
        <select id="bp-building" class="rail__select"><option>Loading…</option></select>
      </div>
      <div>
        <div class="rail__label">Optimise for</div>
        <select id="bp-rank" class="rail__select">
          <option value="constr">Profit per construction point</option>
          <option value="worker">Profit per worker</option>
        </select>
        <p class="bp__railnote" id="bp-ranknote"></p>
      </div>
      <PriceRail />
      <div>
        <div class="rail__label">
          <span>Market prices</span>
          <button type="button" id="bp-reset" class="rail__btn">reset</button>
        </div>
        <div id="bp-prices"></div>
      </div>
    </aside>

    <div class="bp__main">
      <p class="bp__cross">
        One building here. To rank every building at these prices, use
        <a href={`${base}method-comparison`}>Compare Buildings →</a>
      </p>
      <div id="bp-head" class="bp__head"></div>
      <div id="bp-groups" class="bp__groups"></div>

      <details class="bp__all">
        <summary>Every combination, ranked</summary>
        <p class="bp__hint">
          Groups do not interact — every goods line is a flat amount — so the per-group winners
          always combine into the best set. Here for the spread.
        </p>
        <div class="grid"><div class="grid__scroll">
          <table class="vtbl" id="bp-combos"><thead></thead><tbody></tbody></table>
        </div></div>
      </details>

      <p class="caption">
        Revenue − input cost at your prices, per level, at full employment. Goods and jobs only:
        no wages, throughput, economy of scale, mortality or shares. 64 of 97 buildings move goods.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ base }}>
    (async () => {
      // The cross-building table used to live on this page under #compare.
      if (location.hash === '#compare') {
        location.replace(`${base}method-comparison`);
        return;
      }
      const data = await fetch(`${base}data/profit-calc.json`).then((r) => r.json());
      // The importer needs the goods table (for base costs and file-order index).
      window.v3ImportGoods = data.goods;
      window.v3CountryName = data.countries;   // lets the importer name each seat
      document.dispatchEvent(new CustomEvent('v3data-ready'));
      document.addEventListener('v3prices-changed', () => { renderPrices(); renderAll(); });
      // A save loaded on Compare Buildings lands here too: re-open the building
      // on the set it is actually running.
      document.addEventListener('v3save-changed', () => { pickBuilding(sel.value); });
      const $ = (id) => document.getElementById(id);
      const P = window.v3Prices;
      // A locked group is one you have decided for other reasons — you want the
      // tanks even though switching them off pays better — so the optimiser has
      // to work around it instead of switching it off.
      const state = { building: null, choice: {}, locked: {} };
      const priceOf = (g) => P.of(data.goods, g);

      // A handful of methods need a SIBLING method in another group — Bone
      // China only runs on Crystal Glass or Houseware Plastics. A set that
      // breaks that cannot be built, so it must never be offered as "best".
      function buildable(choice) {
        const picked = new Set(Object.keys(choice)
          .map((gi) => state.building.pmGroups[gi]?.pms[choice[gi]]?.id));
        for (const gi of Object.keys(choice)) {
          const pm = state.building.pmGroups[gi]?.pms[choice[gi]];
          if (pm?.reqPms && !pm.reqPms.some((id) => picked.has(id))) return false;
        }
        return true;
      }
      /** What a method is missing, given the rest of the current set. */
      function blockedBy(gi, pi) {
        const pm = state.building.pmGroups[gi]?.pms[pi];
        if (!pm?.reqPms) return null;
        return buildable({ ...state.choice, [gi]: pi }) ? null : pm.reqPmNames.join(' or ');
      }

      // Aggregate a building's goods and jobs for a set of PM choices.
      function evaluate(choice) {
        const flow = {}, jobs = {};
        for (const [gi, pi] of Object.entries(choice)) {
          const pm = state.building.pmGroups[gi]?.pms[pi];
          if (!pm) continue;
          for (const l of pm.inputs) flow[l.g] = (flow[l.g] ?? 0) - l.a;
          for (const l of pm.outputs) flow[l.g] = (flow[l.g] ?? 0) + l.a;
          for (const j of pm.jobs) jobs[j.p] = (jobs[j.p] ?? 0) + j.a;
        }
        let net = 0;
        for (const [g, units] of Object.entries(flow)) net += units * priceOf(g);
        return { flow, jobs, net, totalJobs: Object.values(jobs).reduce((s, a) => s + a, 0) };
      }
      const evaluateWith = (gi, pi) => evaluate({ ...state.choice, [gi]: pi });

      // What "best" means. Construction cost is a property of the BUILDING and
      // no production method modifies it (checked across every PM), so ranking
      // by £/construction inside one building is £ divided by a constant — the
      // same order. It only reorders across buildings, which is why it is a
      // column on Compare Methods and not a mode here.
      const rankBy = () => document.getElementById('bp-rank').value;
      const metric = (r) => {
        const mode = rankBy();
        if (mode === 'worker') return r.totalJobs > 0 ? r.net / r.totalJobs : -Infinity;
        if (mode === 'constr') {
          const c = state.building?.construction;
          return c ? r.net / c : r.net;
        }
        return r.net;
      };

      const liveGroups = () =>
        state.building.pmGroups.map((g, gi) => ({ gi, g })).filter(({ g }) => g.pms.length);

      // The sign belongs in front of the £, not between it and the digits.
      const money = (v, sign) =>
        `${v < 0 ? '−' : sign && v > 0 ? '+' : ''}£${Math.abs(v).toFixed(0)}`;
      const rate = (v, d) => `${v < 0 ? '−' : ''}£${Math.abs(v).toFixed(d)}`;

      // Sign alone gives two buckets, which is not enough to scan a column by.
      // Each number is shaded against the largest of its own column in view, on
      // a gentle curve so the middle of the range stays distinguishable.
      function mag(v, max, text) {
        const t = max > 0 ? Math.min(1, Math.pow(Math.abs(v) / max, 0.55)) : 0;
        const cls = v > 0 ? 'mag mag--good' : v < 0 ? 'mag mag--bad' : 'tone-neutral';
        return `<span class="${cls}${t > 0.86 ? ' mag--peak' : ''}" style="--m:${(0.2 + 0.8 * t).toFixed(3)}">${text}</span>`;
      }

      // What the loaded save has this building set to — the busiest set, when
      // different states run different ones. Groups the save does not mention
      // (a patch renamed them) simply keep the page's default.
      function saveSet() {
        const country = window.v3Save?.country?.();
        if (!country || !state.building) return null;
        const rows = (country.buildings ?? []).filter((r) => r.b === state.building.id);
        if (!rows.length) return null;
        const row = rows.reduce((a, b) => (b.lv > a.lv ? b : a));
        const choice = {};
        let matched = 0;
        for (const { gi, g } of liveGroups()) {
          const pi = g.pms.findIndex((pm) => row.pms.includes(pm.id));
          if (pi >= 0) { choice[gi] = pi; matched++; }
        }
        return matched
          ? { choice, lv: row.lv, n: row.n, tag: country.tag, matched, groups: liveGroups().length }
          : null;
      }

      function allCombinations() {
        let combos = [{}];
        for (const { gi, g } of liveGroups()) {
          const next = [];
          // A locked group contributes only its chosen method.
          const options = state.locked[gi] ? [state.choice[gi]] : g.pms.map((_, pi) => pi);
          for (const c of combos) for (const pi of options) next.push({ ...c, [gi]: pi });
          combos = next;
        }
        return combos.filter(buildable);
      }

      // ── Building picker ────────────────────────────────────────────
      const sel = $('bp-building');
      sel.innerHTML = '';
      let lastGroup = null, optgroup = null;
      for (const b of data.buildings) {
        if (b.group !== lastGroup) {
          optgroup = document.createElement('optgroup');
          optgroup.label = b.group ?? 'Other';
          sel.appendChild(optgroup);
          lastGroup = b.group;
        }
        const o = document.createElement('option');
        o.value = b.id; o.textContent = b.name;
        optgroup.appendChild(o);
      }

      function pickBuilding(id) {
        state.building = data.buildings.find((b) => b.id === id);
        state.choice = {};
        state.locked = {};
        for (const { gi } of liveGroups()) state.choice[gi] = 0;
        // Start from what you are actually running, so "load best set" reads as
        // the gain on the table rather than the gain over an arbitrary default.
        const inSave = saveSet();
        state.fromSave = inSave;
        if (inSave) Object.assign(state.choice, inSave.choice);
        renderPrices();
        renderAll();
      }

      // ── Prices (rail) ──────────────────────────────────────────────
      // Only the goods this building can touch, so the rail stays short and
      // every slider on screen is one that moves this building's number.
      function renderPrices() {
        const goods = new Set();
        for (const g of state.building.pmGroups)
          for (const pm of g.pms)
            for (const l of [...pm.inputs, ...pm.outputs]) goods.add(l.g);
        const list = [...goods].sort((a, b) => data.goods[a].name.localeCompare(data.goods[b].name));

        $('bp-prices').innerHTML = list.map((g) => `
          <div class="prow">
            <div class="prow__head">
              <img src="${base}${data.goods[g].icon}" alt="" loading="lazy" />
              <span class="prow__name">${data.goods[g].name}</span>
              <span class="prow__val" data-val="${g}"></span>
            </div>
            <input type="range" min="-75" max="75" step="1" value="${P.get(g)}" data-good="${g}" />
          </div>`).join('');

        $('bp-prices').querySelectorAll('input[data-good]').forEach((input) =>
          input.addEventListener('input', () => {
            P.set(input.dataset.good, Number(input.value));
            renderPriceLabels();
            renderAll();      // results sit beside the rail, so they update in view
          }));
        renderPriceLabels();
      }

      function renderPriceLabels() {
        for (const el of $('bp-prices').querySelectorAll('[data-val]')) {
          const g = el.dataset.val, pct = P.get(g);
          el.textContent = `£${priceOf(g).toFixed(0)}${pct ? ` (${pct > 0 ? '+' : ''}${pct}%)` : ''}`;
          el.classList.toggle('is-off', pct !== 0);
        }
      }

      // ── Results ────────────────────────────────────────────────────
      function renderHead() {
        const { flow, jobs, net, totalJobs } = evaluate(state.choice);
        const lines = Object.entries(flow)
          .filter(([, u]) => u !== 0)
          .map(([g, u]) => ({ g, u, value: u * priceOf(g) }))
          .sort((a, b) => b.value - a.value);
        const scored = allCombinations().map((c) => ({ c, r: evaluate(c) }));
        const bestEntry = scored.slice().sort((a, b) => metric(b.r) - metric(a.r))[0];
        const best = bestEntry.r.net;
        const atBest = metric({ net, totalJobs }) >= metric(bestEntry.r) - 1e-9;
        const constr = state.building.construction;
        const lockCount = Object.keys(state.locked).length;
        const maxLine = Math.max(0, ...lines.map((l) => Math.abs(l.value)));

        $('bp-head').innerHTML = `
          <div class="bp__netrow">
            <div class="bp__net ${net >= 0 ? 'tone-good' : 'tone-bad'}">${money(net)}<span>net / level</span></div>
            <div class="bp__jobs">${totalJobs.toLocaleString()}<span>workers</span></div>
            <div class="bp__perw">${totalJobs > 0 ? rate(net / totalJobs, 2) : '—'}<span>per worker</span></div>
            <div class="bp__perw" title="Construction points this building costs — fixed per building, so it never changes which method wins here">${
              constr ? rate(net / constr, 2) : '—'}<span>per construction${constr ? ` (of ${constr})` : ''}</span></div>
            ${atBest
              ? `<span class="bp__atbest">best set${lockCount ? ' within your locks' : ''} at these prices</span>`
              : `<button type="button" id="bp-loadbest" class="bp__bestbtn">load best set${
                  lockCount ? ' (keeping locks)' : ''} (${money(best)})</button>`}
          </div>
          ${state.fromSave ? `<p class="bp__fromsave">Your save's set ·
            <b>${state.fromSave.lv.toLocaleString()}</b> level${state.fromSave.lv === 1 ? '' : 's'}
            in ${state.fromSave.n} building${state.fromSave.n === 1 ? '' : 's'}${
              state.fromSave.matched < state.fromSave.groups
                ? ` · ${state.fromSave.groups - state.fromSave.matched} group${state.fromSave.groups - state.fromSave.matched === 1 ? '' : 's'} didn't match this patch`
                : ''}</p>` : ''}
          <div class="bp__flow">
            ${lines.map((l) => `<span class="bp__fl">
              <img src="${base}${data.goods[l.g].icon}" alt="" loading="lazy" />
              ${data.goods[l.g].name}
              <b class="${l.u > 0 ? 'tone-good' : 'tone-bad'}">${l.u > 0 ? '+' : ''}${l.u}</b>
              ${mag(l.value, maxLine, `<i>${money(l.value)}</i>`)}</span>`).join('')}
            ${Object.entries(jobs).map(([p, a]) => `<span class="bp__fl bp__fl--job">${p} <b>${a}</b></span>`).join('')}
          </div>`;

        const btn = $('bp-loadbest');
        if (btn) btn.addEventListener('click', () => {
          state.choice = { ...bestEntry.c };
          renderAll();
        });
      }

      function renderGroups() {
        const mode = rankBy();
        $('bp-groups').innerHTML = liveGroups().map(({ gi, g }) => {
          const current = state.choice[gi];
          const currentNet = evaluateWith(gi, current).net;
          const options = g.pms.map((pm, pi) => {
            const r = evaluateWith(gi, pi);
            const blocked = blockedBy(gi, pi);
            return {
              pi, pm, blocked, net: r.net, jobs: r.totalJobs, delta: r.net - currentNet,
              perWorker: r.totalJobs > 0 ? r.net / r.totalJobs : null,
              perConstr: state.building.construction ? r.net / state.building.construction : null,
              score: blocked ? -Infinity : metric(r),
            };
          });
          const best = Math.max(...options.map((o) => o.score));
          const ranked = [...options].sort((a, b) => b.score - a.score || a.pi - b.pi);
          const mNet = Math.max(0, ...options.filter((o) => !o.blocked).map((o) => Math.abs(o.net)));
          const mDelta = Math.max(0, ...options.filter((o) => !o.blocked).map((o) => Math.abs(o.delta)));
          const inSave = state.fromSave?.choice[gi];
          return `
            <div class="bp__group">
              <div class="bp__gname">
                <span>${g.name}</span>
                <button type="button" class="bp__lock ${state.locked[gi] ? 'is-on' : ''}"
                  data-lock="${gi}"
                  title="${state.locked[gi]
                    ? 'Locked — the optimiser keeps this choice'
                    : 'Lock this group so the optimiser cannot change it'}">
                  ${state.locked[gi] ? '&#128274; locked' : '&#128275; lock'}
                </button>
              </div>
              <table class="vtbl bp__gtable">
                <colgroup>
                  <col /><col class="bp__c1" /><col class="bp__c1" />
                  <col class="bp__c2" /><col class="bp__c2" /><col class="bp__c2" />
                </colgroup>
                <thead><tr>
                  <th>Method</th>
                  <th class="num">Net £</th>
                  <th class="num">vs now</th>
                  <th class="num">Jobs</th>
                  <th class="num ${mode === 'worker' ? 'is-opt' : ''}" title="Profit per worker">£/wkr</th>
                  <th class="num ${mode === 'constr' ? 'is-opt' : ''}" title="Profit per construction point">£/con</th>
                </tr></thead>
                <tbody>${ranked.map((o) => `
                  <tr class="bp__opt ${o.pi === current ? 'is-current' : ''}${o.blocked ? ' is-blocked' : ''}" data-gi="${gi}" data-pi="${o.pi}">
                    <td class="bp__optname" title="${o.pm.name}">
                      <img src="${base}${o.pm.icon ?? ''}" alt="" loading="lazy"
                           onerror="this.style.visibility='hidden'" />
                      <span class="bp__pmname">${o.pm.name}</span>
                      ${o.score === best ? '<span class="bp__badge">best</span>' : ''}
                      ${o.pi === inSave && o.score !== best ? '<span class="bp__badge bp__badge--save">yours</span>' : ''}
                      ${o.blocked ? `<span class="bp__badge bp__badge--blocked" title="Needs ${o.blocked} in another group">needs ${o.blocked}</span>` : ''}
                    </td>
                    <td class="num">${mag(o.net, mNet, `<b>${money(o.net)}</b>`)}</td>
                    <td class="num">${o.pi === current ? '<span class="bp__cur">—</span>'
                      : mag(o.delta, mDelta, money(o.delta, true))}</td>
                    <td class="num dim">${o.jobs}</td>
                    <td class="num ${mode === 'worker' ? 'is-opt' : 'dim'}">${
                      o.perWorker == null ? '—' : o.perWorker.toFixed(2)}</td>
                    <td class="num ${mode === 'constr' ? 'is-opt' : 'dim'}">${
                      o.perConstr == null ? '—' : o.perConstr.toFixed(2)}</td>
                  </tr>`).join('')}
                </tbody>
              </table>
            </div>`;
        }).join('');

        $('bp-groups').querySelectorAll('.bp__lock').forEach((b) =>
          b.addEventListener('click', () => {
            const gi = b.dataset.lock;
            if (state.locked[gi]) delete state.locked[gi]; else state.locked[gi] = true;
            renderAll();
          }));
        // Picking a method inside a locked group locks it to that method.
        $('bp-groups').querySelectorAll('.bp__opt').forEach((tr) =>
          tr.addEventListener('click', () => {
            state.choice[tr.dataset.gi] = Number(tr.dataset.pi);
            renderAll();
          }));
      }

      function renderCombos() {
        if (!$('bp-combos').closest('details').open) return; // only when opened
        const groups = liveGroups();
        const scored = allCombinations().map((choice) => {
          const r = evaluate(choice);
          return { choice, net: r.net, jobs: r.totalJobs,
                   perWorker: r.totalJobs > 0 ? r.net / r.totalJobs : null,
                   score: metric(r) };
        }).sort((a, b) => b.score - a.score);
        const same = (c) => groups.every(({ gi }) => c[gi] === state.choice[gi]);
        const mNet = Math.max(0, ...scored.map((r) => Math.abs(r.net)));

        $('bp-combos').tHead.innerHTML = `<tr><th class="num" style="width:3rem;">#</th>
          ${groups.map(({ g }) => `<th>${g.name}</th>`).join('')}
          <th class="num">Net £</th><th class="num">Jobs</th><th class="num">£/wkr</th></tr>`;
        $('bp-combos').tBodies[0].innerHTML = scored.map((r, i) => `
          <tr class="bp__opt ${same(r.choice) ? 'is-current' : ''}"
              data-combo="${groups.map(({ gi }) => `${gi}:${r.choice[gi]}`).join(',')}">
            <td class="num dim">${i + 1}</td>
            ${groups.map(({ gi, g }) => `<td>${g.pms[r.choice[gi]].name}</td>`).join('')}
            <td class="num">${mag(r.net, mNet, `<b>${money(r.net)}</b>`)}</td>
            <td class="num dim">${r.jobs}</td>
            <td class="num dim">${r.perWorker == null ? '—' : r.perWorker.toFixed(2)}</td>
          </tr>`).join('');

        $('bp-combos').tBodies[0].querySelectorAll('tr').forEach((tr) =>
          tr.addEventListener('click', () => {
            for (const part of tr.dataset.combo.split(',')) {
              const [gi, pi] = part.split(':');
              state.choice[gi] = Number(pi);
            }
            renderAll();
          }));
      }

      function renderAll() { rankNote(); renderHead(); renderGroups(); renderCombos(); }

      $('bp-combos').closest('details').addEventListener('toggle', renderCombos);
      function rankNote() {
        const c = state.building?.construction;
        const notes = {
          worker: 'Ranked by £ per job.',
          constr: `Ranked by £ per construction point. Every method here divides by the same ${c ?? '—'}, `
            + `so the order matches total £. Costs differ <a href="${base}method-comparison">across buildings</a>.`,
        };
        $('bp-ranknote').innerHTML = notes[rankBy()];
      }
      $('bp-rank').addEventListener('change', () => { rankNote(); renderAll(); });
      // The construction note names this building's cost, so it follows the picker.
      sel.addEventListener('change', rankNote);
      rankNote();
      $('bp-reset').addEventListener('click', () => { P.reset(); renderPrices(); renderAll(); });
      sel.addEventListener('change', () => pickBuilding(sel.value));
      pickBuilding(data.buildings[0].id);
    })();
  </script>

  <style is:global>
    .bp { display: grid; grid-template-columns: minmax(14rem, 17rem) 1fr; gap: 1.6rem; align-items: start; }
    .bp__main { min-width: 0; }
    @media (max-width: 900px) { .bp { grid-template-columns: 1fr; } }

    .bp__netrow {
      display: flex; align-items: baseline; gap: 1.6rem; flex-wrap: wrap;
      padding-bottom: 0.5rem; border-bottom: 3px double var(--gold-deep); margin-bottom: 0.9rem;
    }
    .bp__net { font-family: var(--font-display); font-size: 2.2rem; line-height: 1; }
    .bp__jobs, .bp__perw {
      font-family: var(--font-display); font-size: 1.25rem; color: var(--text-soft); line-height: 1;
    }
    .bp__net span, .bp__jobs span, .bp__perw span {
      font-family: var(--font-ui); font-size: 0.62rem; text-transform: uppercase;
      letter-spacing: 0.14em; color: var(--text-dim); margin-left: 0.45rem;
    }
    .bp__atbest {
      font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--tone-good);
      border: 1px solid color-mix(in srgb, var(--tone-good) 40%, transparent);
      border-radius: 999px; padding: 0.12rem 0.5rem; margin-left: auto;
    }
    .bp__bestbtn {
      margin-left: auto; font: inherit; font-size: 0.72rem; cursor: pointer;
      background: var(--bg-elev); border: 1px solid var(--gold-deep);
      color: var(--gold); border-radius: 6px; padding: 0.3rem 0.7rem;
    }
    .bp__bestbtn:hover { background: var(--bg-elev-2); }

    .bp__flow { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; margin-bottom: 1.1rem; }
    .bp__fl { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; white-space: nowrap; }
    .bp__fl img { width: 17px; height: 17px; object-fit: contain; }
    .bp__fl b { font-variant-numeric: tabular-nums; }
    .bp__fl i { font-style: normal; color: var(--text-dim); font-size: 0.75rem; }
    .bp__fl--job { color: var(--text-dim); }

    .bp__groups {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(30rem, 1fr));
      gap: 0.4rem 1.5rem; align-items: start;
    }
    /* A grid item defaults to min-width:auto, which lets a wide table push its
       track open and ride over the group beside it. Pin it shut and let the
       table divide a known width instead. */
    .bp__group { min-width: 0; }
    .bp__gname {
      font-family: var(--font-ui); font-size: 0.6rem; text-transform: uppercase;
      letter-spacing: 0.16em; color: var(--gold-soft); font-weight: 500;
      border-bottom: 1px solid var(--border); padding-bottom: 0.2rem;
      display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    }
    .bp__lock {
      font: inherit; font-size: 0.55rem; letter-spacing: 0.08em; cursor: pointer;
      background: none; border: 0; color: var(--text-faint); padding: 0;
    }
    .bp__lock:hover { color: var(--gold); }
    .bp__lock.is-on { color: var(--gold); }
