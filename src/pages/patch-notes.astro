---
import Base from '../layouts/Base.astro';
import changelog from '../data/changelog.json';
import patch from '../../data/patch.json';

const { from, to, sections } = changelog as any;
const totals = sections.reduce(
  (t: any, s: any) => ({
    a: t.a + s.added.length,
    r: t.r + s.removed.length,
    c: t.c + s.changed.length,
  }),
  { a: 0, r: 0, c: 0 },
);
---
<Base
  title="Patch Notes"
  active="patch-notes"
  eyebrow="Tools"
  description="What changed in Victoria 3's data between patches, diffed automatically from the game's own files."
  pageStats={[
    { value: totals.a, label: 'added' },
    { value: totals.c, label: 'changed' },
    { value: totals.r, label: 'removed' },
  ]}
>
  <p class="pn__lead">
    Every dataset diffed against the previous patch's snapshot. <b>{from}</b> → <b>{to}</b>.
  </p>

  {sections.length === 0 ? (
    <p class="pn__none">
      No data changes since the last snapshot — the site matches game build {patch.version}.
    </p>
  ) : (
    sections.map((s: any) => (
      <>
        <h2 class="sect">{s.dataset}</h2>
        {s.isNew && <p class="pn__new">New dataset in this build.</p>}
        {s.added.length > 0 && (
          <p class="pn__row">
            <span class="pn__tag tone-good">added {s.added.length}</span>
            {s.added.map((a: any) => a.name).join(', ')}
          </p>
        )}
        {s.removed.length > 0 && (
          <p class="pn__row">
            <span class="pn__tag tone-bad">removed {s.removed.length}</span>
            {s.removed.join(', ')}
          </p>
        )}
        {s.changed.length > 0 && (
          <div class="grid"><div class="grid__scroll">
            <table class="vtbl">
              <thead><tr><th style="width: 18rem;">Entry</th><th>Changes</th></tr></thead>
              <tbody>
                {s.changed.map((c: any) => (
                  <tr>
                    <td class="lead-cell"><span class="lead">{c.name}</span></td>
                    <td class="dim">{c.diffs.join(' · ')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div></div>
        )}
      </>
    ))
  )}

  <p class="caption">
    Generated by scripts/changelog.mjs against data/snapshots · nested lists report as counts, not full contents
  </p>

  <style is:global>
    .pn__lead { font-size: 0.85rem; color: var(--text-soft); max-width: 52rem; margin: 0 0 1rem; }
    .pn__none { font-size: 0.85rem; color: var(--text-dim); }
    .pn__new { font-size: 0.8rem; color: var(--text-dim); }
    .pn__row { font-size: 0.82rem; color: var(--text-soft); margin: 0.35rem 0; }
    .pn__tag {
      font-family: var(--font-mono); font-size: 0.6rem; text-transform: uppercase;
      letter-spacing: 0.08em; margin-right: 0.5rem;
    }
  </style>
</Base>
