---
import Base from '../layouts/Base.astro';
import TableTools from '../components/TableTools.astro';
import ModifierList from '../components/ModifierList.astro';
import statesJson from '../data/states.json';
import locationsJson from '../data/locations.json';
import { getEntity } from '../lib/entities';

const base = import.meta.env.BASE_URL;
const byId = new Map((locationsJson as any).locations.map((l: any) => [l.id, l]));
const states = ((statesJson as any).states as any[]).map((s) => ({ ...s, loc: byId.get(s.id) }));
const traits = (statesJson as any).traits as any[];

const capText = (s: any) => s.cappedResources.map((r: any) => `${r.name} ${r.cap}`).join('; ');

// One sortable column per resource, so the table can be ordered by any of
// them. Short header labels: the building names repeat "Mines"/"Camps".
const resourceCols = [...new Map(
  states.flatMap((s) => s.cappedResources.map((r: any) => [r.id, r])),
).values()]
  .map((r: any) => ({
    id: r.id,
    slug: r.slug,
    name: r.name,
    short: r.name.replace(/ (Mines?|Camps?|Wharfs?|Wharves|Fields?|Rigs?|Stations?|Plantations?)$/, ''),
  }))
  .sort((a, b) => a.short.localeCompare(b.short));
const capOf = (s: any, id: string) => s.cappedResources.find((r: any) => r.id === id)?.cap ?? 0;

const discoverCols = [...new Map(
  states.flatMap((s) => s.discoverables.filter((d: any) => d.group).map((d: any) => [d.group, d])),
).values()]
  .map((d: any) => ({ group: d.group, name: d.name ?? d.group }))
  .sort((a, b) => a.name.localeCompare(b.name));
const findOf = (s: any, group: string) =>
  s.discoverables.find((d: any) => d.group === group)?.amount ?? 0;
const csv = {
  header: [
    'State', 'Id', 'Region', '1836 owner', 'Population', 'Produces', 'Arable land', 'Arable types',
    ...resourceCols.map((r) => r.name),
    ...discoverCols.map((d) => `${d.name} (undiscovered)`),
    'Traits', 'Coastal',
  ],
  rows: states.map((s) => [
    s.name, s.id, s.region?.name ?? '',
    s.loc?.owners.map((o: any) => o.name).join('; ') ?? '',
    s.loc?.population ?? '',
    s.loc?.produces.map((g: any) => `${g.name} ${g.amount}`).join('; ') ?? '',
    s.arableLand,
    s.arableResources.map((r: any) => r.name).join('; '),
    ...resourceCols.map((r) => capOf(s, r.id) || ''),
    ...discoverCols.map((d) => findOf(s, d.group) || ''),
    s.traits.map((t: any) => t.name).join('; '), s.navalExit ? 'yes' : '',
  ]),
};
---
<Base
  title="Locations"
  active="states"
  eyebrow="World"
  pageFilter="Filter by state, owner, culture, good, or building…"
  pageStats={[
    { value: states.length, label: 'locations' },
    { value: traits.length, label: 'state traits' },
  ]}
>
  <TableTools csvId="states" csvName="victoria3-states" />

  <div class="grid">
    <div class="grid__scroll">
      <table class="vtbl" id="states-table" data-sortable>
        <thead>
          <tr>
            <th style="min-width: 12rem;">State</th>
            <th style="width: 11rem;">Region</th>
            <th style="width: 10rem;">1836 owner</th>
            <th class="num" style="width: 7rem;">Population</th>
            <th class="num" style="width: 5.5rem;" title="Arable land — max total levels of farming/ranching buildings">Arable</th>
            <th style="width: 16rem;">Arable types</th>
            {resourceCols.map((r) => (
              <th class="num" style="width: 5rem;" title={`${r.name} — maximum levels this state can hold`}>{r.short}</th>
            ))}
            {discoverCols.map((d) => (
              <th class="num" style="width: 5.5rem;" title={`${d.name} that prospecting can still reveal`}>{d.name.replace(/ (Fields?|Rigs?|Plantations?)$/, '')}<span class="st__und">?</span></th>
            ))}
            <th style="min-width: 12rem;">Traits</th>
          </tr>
        </thead>
        <tbody>
          {states.map((s) => (
            <tr id={s.id} data-name={[
              s.name, s.id, s.region?.name ?? '',
              s.traits.map((t: any) => t.name).join(' '),
              s.loc?.owners.map((o: any) => o.name).join(' ') ?? '',
              s.loc?.cultures.slice(0, 6).map((c: any) => c.name).join(' ') ?? '',
              s.loc?.produces.map((g: any) => g.name).join(' ') ?? '',
              s.loc?.buildings.map((b: any) => b.name).join(' ') ?? '',
            ].join(' ').toLowerCase()}>
              <td class="lead-cell" data-sort={s.name}>
                <span class="lead">
                  <a href={`${base}locations/${s.loc?.slug ?? s.id.replace('STATE_', '').toLowerCase()}`}>{s.name}</a>
                  {s.navalExit && <span class="chip" title="Has sea access">· coastal</span>}
                </span>
              </td>
              <td class="dim">{s.region?.name ?? <span class="cell__dash">—</span>}</td>
              <td class="dim" title={s.loc?.split ? s.loc.owners.map((o: any) => `${o.name} ${o.population.toLocaleString()}`).join(' · ') : undefined}>
                {s.loc?.owners.length
                  ? <>{s.loc.owners[0].name}{s.loc.split && <span class="st__und"> +{s.loc.owners.length - 1}</span>}</>
                  : <span class="cell__dash">—</span>}
              </td>
              <td class="num" data-sort={s.loc?.population ?? ''}>{s.loc?.population ? s.loc.population.toLocaleString() : <span class="cell__dash">—</span>}</td>
              <td class="num" data-sort={s.arableLand}>{s.arableLand}</td>
              <td class="dim">
                {s.arableResources.map((r: any, i: number) => {
                  const e = getEntity(r.id);
                  return (
                    <>
                      {i > 0 && ', '}
                      {e?.icon && <img class="term__icon" src={`${base}${e.icon}`} alt="" loading="lazy" />}
                      <a href={`${base}buildings/${r.slug}`}>{r.name.replace(/ (Farms?|Ranches|Plantations?)$/, '')}</a>
                    </>
                  );
                })}
              </td>
              {resourceCols.map((r) => {
                const n = capOf(s, r.id);
                return <td class="num" data-sort={n || ''}>{n || <span class="cell__dash">—</span>}</td>;
              })}
              {discoverCols.map((d) => {
                const n = findOf(s, d.group);
                return <td class="num dim" data-sort={n || ''}>{n || <span class="cell__dash">—</span>}</td>;
              })}
              <td class="dim">
                {s.traits.length ? s.traits.map((t: any, i: number) => (
                  <>{i > 0 && ', '}<a href={`${base}states#${t.id}`}>{t.name}</a></>
                )) : <span class="cell__dash">—</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h2 class="sect">State traits</h2>
  <div class="grid">
    <div class="grid__scroll">
      <table class="vtbl">
        <thead>
          <tr>
            <th style="width: 18rem;">Trait</th>
            <th>Effects</th>
            <th class="num" style="width: 5rem;">States</th>
          </tr>
        </thead>
        <tbody>
          {traits.map((t) => (
            <tr id={t.id}>
              <td class="lead-cell"><span class="lead">{t.name}</span></td>
              <td><ModifierList mods={t.modifiers} inline /></td>
              <td class="num dim" title={t.states.join(', ')}>{t.states.length}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p class="caption">
    Every state region · open one for its 1836 pops, buildings, and output · discoverable amounts
    are what prospecting can reveal · sea regions excluded
  </p>

  <script is:inline define:vars={{ csv }}>
    window.v3Csv = window.v3Csv || {};
    window.v3Csv.states = () => csv;
  </script>

  <script is:inline>
    const filter = document.getElementById('page-filter');
    if (filter) {
      const rows = [...document.querySelectorAll('#states-table tbody tr')];
      filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        for (const r of rows) r.classList.toggle('is-hidden', !!q && !r.dataset.name.includes(q));
      });
    }
  </script>
  <style is:global>
    .st__und { color: var(--text-faint); margin-left: 0.15em; }
  </style>
</Base>
