---
import Base from '../layouts/Base.astro';
import TableTools from '../components/TableTools.astro';
import ModifierList from '../components/ModifierList.astro';
import statesJson from '../data/states.json';
import { getEntity } from '../lib/entities';

const base = import.meta.env.BASE_URL;
const states = (statesJson as any).states as any[];
const traits = (statesJson as any).traits as any[];

const capText = (s: any) => s.cappedResources.map((r: any) => `${r.name} ${r.cap}`).join('; ');
const csv = {
  header: ['State', 'Id', 'Region', 'Arable land', 'Arable types', 'Resource caps', 'Discoverables', 'Traits', 'Coastal'],
  rows: states.map((s) => [
    s.name, s.id, s.region?.name ?? '', s.arableLand,
    s.arableResources.map((r: any) => r.name).join('; '), capText(s),
    s.discoverables.map((d: any) => `${d.name}${d.amount ? ` ${d.amount}` : ''}`).join('; '),
    s.traits.map((t: any) => t.name).join('; '), s.navalExit ? 'yes' : '',
  ]),
};
---
<Base
  title="States"
  active="states"
  eyebrow="World"
  pageFilter="Filter states…"
  pageStats={[
    { value: states.length, label: 'states' },
    { value: traits.length, label: 'state traits' },
  ]}
>
  <TableTools csvId="states" csvName="victoria3-states" />

  <div class="grid">
    <div class="grid__scroll">
      <table class="vtbl" id="states-table" data-sortable>
        <thead>
          <tr>
            <th style="min-width: 12rem;">State</th>
            <th style="width: 11rem;">Region</th>
            <th class="num" style="width: 5.5rem;" title="Arable land — max total levels of farming/ranching buildings">Arable</th>
            <th style="width: 16rem;">Arable types</th>
            <th style="min-width: 18rem;">Resource caps</th>
            <th style="width: 12rem;">Discoverable</th>
            <th style="min-width: 12rem;">Traits</th>
          </tr>
        </thead>
        <tbody>
          {states.map((s) => (
            <tr id={s.id} data-name={`${s.name} ${s.id} ${s.region?.name ?? ''} ${s.traits.map((t: any) => t.name).join(' ')}`.toLowerCase()}>
              <td class="lead-cell" data-sort={s.name}>
                <span class="lead">
                  {s.name}
                  {s.navalExit && <span class="chip" title="Has sea access">· coastal</span>}
                </span>
              </td>
              <td class="dim">{s.region?.name ?? <span class="cell__dash">—</span>}</td>
              <td class="num" data-sort={s.arableLand}>{s.arableLand}</td>
              <td class="dim">
                {s.arableResources.map((r: any, i: number) => {
                  const e = getEntity(r.id);
                  return (
                    <>
                      {i > 0 && ', '}
                      {e?.icon && <img class="term__icon" src={`${base}${e.icon}`} alt="" loading="lazy" />}
                      <a href={`${base}buildings/${r.slug}`}>{r.name.replace(/ (Farms?|Ranches|Plantations?)$/, '')}</a>
                    </>
                  );
                })}
              </td>
              <td class="dim">
                {s.cappedResources.length ? s.cappedResources.map((r: any, i: number) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`${base}buildings/${r.slug}`}>{r.name.replace(/ (Mines?|Camps?|Wharfs?|Wharves|Fields?|Rigs?|Wells)$/, '')}</a> <b>{r.cap}</b>
                  </>
                )) : <span class="cell__dash">—</span>}
              </td>
              <td class="dim">
                {s.discoverables.length ? s.discoverables.map((d: any, i: number) => (
                  <>{i > 0 && ', '}{d.name}{d.amount ? <> <b>{d.amount}</b></> : null}</>
                )) : <span class="cell__dash">—</span>}
              </td>
              <td class="dim">
                {s.traits.length ? s.traits.map((t: any, i: number) => (
                  <>{i > 0 && ', '}<a href={`${base}states#${t.id}`}>{t.name}</a></>
                )) : <span class="cell__dash">—</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h2 class="sect">State traits</h2>
  <div class="grid">
    <div class="grid__scroll">
      <table class="vtbl">
        <thead>
          <tr>
            <th style="width: 18rem;">Trait</th>
            <th>Effects</th>
            <th class="num" style="width: 5rem;">States</th>
          </tr>
        </thead>
        <tbody>
          {traits.map((t) => (
            <tr id={t.id}>
              <td class="lead-cell"><span class="lead">{t.name}</span></td>
              <td><ModifierList mods={t.modifiers} inline /></td>
              <td class="num dim" title={t.states.join(', ')}>{t.states.length}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p class="caption">Discoverable amounts are the totals prospecting can reveal · sea regions excluded</p>

  <script is:inline define:vars={{ csv }}>
    window.v3Csv = window.v3Csv || {};
    window.v3Csv.states = () => csv;
  </script>

  <script is:inline>
    const filter = document.getElementById('page-filter');
    if (filter) {
      const rows = [...document.querySelectorAll('#states-table tbody tr')];
      filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        for (const r of rows) r.classList.toggle('is-hidden', !!q && !r.dataset.name.includes(q));
      });
    }
  </script>
</Base>
