---
import Base from '../layouts/Base.astro';
import ModifierList from '../components/ModifierList.astro';
import blocsJson from '../data/power_blocs.json';

const base = import.meta.env.BASE_URL;
const identities = (blocsJson as any).identities as any[];
const groups = (blocsJson as any).principleGroups as any[];
---
<Base
  title="Power Blocs"
  active="power-blocs"
  eyebrow="Diplomacy"
  pageStats={[
    { value: identities.length, label: 'identities' },
    { value: groups.length, label: 'principle groups' },
  ]}
>
  <h2 class="sect">Identities</h2>
  <div class="grid">
    <div class="grid__scroll">
      <table class="vtbl">
        <thead>
          <tr>
            <th style="width: 13rem;">Identity</th>
            <th>Bloc</th>
            <th>Leader</th>
            <th>Members</th>
          </tr>
        </thead>
        <tbody>
          {identities.map((ident) => (
            <tr id={ident.id}>
              <td class="lead-cell">
                <span class="lead">
                  <img class="lead__icon" src={`${base}${ident.icon}`} alt="" loading="lazy" />
                  {ident.name}
                </span>
              </td>
              <td><ModifierList mods={ident.blocModifiers} /></td>
              <td><ModifierList mods={ident.leaderModifiers} /></td>
              <td><ModifierList mods={ident.memberModifiers} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h2 class="sect">Principles</h2>
  {groups.map((g) => (
    <>
      <h3 class="pbgroup" id={g.id}>
        {g.name}
        {g.primaryFor && <span class="pbgroup__meta">primary for {g.primaryFor.name}</span>}
      </h3>
      <div class="grid"><div class="grid__scroll">
        <table class="vtbl">
          <thead>
            <tr>
              <th class="num" style="width: 4rem;">Tier</th>
              <th>Bloc</th>
              <th>Leader</th>
              <th>Members</th>
            </tr>
          </thead>
          <tbody>
            {g.principles.map((p: any) => (
              <tr id={p.id}>
                <td class="num">{p.tier ?? <span class="cell__dash">—</span>}</td>
                <td><ModifierList mods={p.blocModifiers} /></td>
                <td><ModifierList mods={p.leaderModifiers} /></td>
                <td>
                  <ModifierList mods={p.memberModifiers} />
                  {p.institution && <div class="dim" style="color: var(--text-dim); margin-top: 0.2rem;">Grants institution: {p.institution.name}</div>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div></div>
    </>
  ))}

  <p class="caption">Higher principle tiers include the lower tiers' effects only where their modifiers repeat them — values shown verbatim</p>

  <style is:global>
    .pbgroup {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 600;
      margin: 1rem 0 0.35rem;
      display: flex; align-items: baseline; gap: 0.7rem;
    }
    .pbgroup__meta {
      font-family: var(--font-ui);
      font-size: 0.68rem;
      color: var(--text-faint);
    }
  </style>
</Base>
