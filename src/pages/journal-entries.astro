---
import Base from '../layouts/Base.astro';
import ModifierList from '../components/ModifierList.astro';
import jesJson from '../data/journal_entries.json';

const jes = (jesJson as any).journalEntries as any[];
const groups = [...new Set(jes.map((j) => j.group?.name ?? 'Ungrouped'))];
---
<Base
  title="Journal Entries"
  active="journal-entries"
  eyebrow="Journal & Events"
  pageFilter="Filter journal entries…"
  pageStats={[{ value: jes.length, label: 'journal entries' }]}
>
  {groups.map((g) => (
    <div data-jegroup>
      <h2 class="sect">{g}</h2>
      <div class="grid"><div class="grid__scroll">
        <table class="vtbl">
          <thead>
            <tr>
              <th style="min-width: 14rem;">Journal entry</th>
              <th style="min-width: 22rem;">Reason</th>
              <th style="min-width: 14rem;">Goal</th>
              <th class="num" style="width: 6rem;" title="Days before the entry times out">Timeout</th>
              <th style="min-width: 12rem;">Completion rewards</th>
            </tr>
          </thead>
          <tbody>
            {jes.filter((j) => (j.group?.name ?? 'Ungrouped') === g).map((j) => (
              <tr id={j.id} data-name={`${j.name} ${j.id} ${g} ${j.reason ?? ''}`.toLowerCase()}>
                <td class="lead-cell"><span class="lead">{j.name}</span></td>
                <td class="dim" style="font-size: 0.76rem; white-space: normal;">{j.reason ?? <span class="cell__dash">—</span>}</td>
                <td class="dim" style="font-size: 0.76rem; white-space: normal;">{j.goal ?? <span class="cell__dash">—</span>}</td>
                <td class="num dim">{j.timeout ?? <span class="cell__dash">—</span>}</td>
                <td>
                  {j.rewards.length ? j.rewards.map((r: any) => (
                    <div style="margin-bottom: 0.2rem;">
                      <span class="dim">{r.name}</span>
                      {r.modifiers.length > 0 && <>: <ModifierList mods={r.modifiers} inline /></>}
                    </div>
                  )) : <span class="cell__dash">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div></div>
    </div>
  ))}

  <p class="caption">
    Completion/failure conditions and per-entry effects are scripted — rewards shown are the named
    modifiers granted on completion where statically extractable
  </p>

  <script is:inline>
    const filter = document.getElementById('page-filter');
    if (filter) {
      const rows = [...document.querySelectorAll('tbody tr[data-name]')];
      filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        for (const r of rows) r.classList.toggle('is-hidden', !!q && !r.dataset.name.includes(q));
        document.querySelectorAll('[data-jegroup]').forEach((wrap) => {
          const any = [...wrap.querySelectorAll('tbody tr[data-name]')].some((r) => !r.classList.contains('is-hidden'));
          wrap.classList.toggle('is-hidden', !any);
        });
      });
    }
  </script>
</Base>
