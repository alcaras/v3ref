---
import Base from '../layouts/Base.astro';
import conceptsJson from '../data/concepts.json';

const base = import.meta.env.BASE_URL;
const concepts = (conceptsJson as any).concepts as any[];
---
<Base
  title="Concepts"
  active="concepts"
  eyebrow="Concepts"
  pageFilter="Filter concepts…"
  pageStats={[{ value: concepts.length, label: 'encyclopedia entries' }]}
>
  <div class="concepts">
    {concepts.map((c) => (
      <div class="concept" id={c.id} data-name={`${c.name} ${c.id} ${c.description}`.toLowerCase()}>
        <h3 class="concept__name">{c.name}</h3>
        <p class="concept__desc">{c.description}</p>
        {c.related.length > 0 && (
          <p class="concept__rel">
            See also: {c.related.map((r: string, i: number) => (
              <>{i > 0 && ', '}<a href={`#${r}`}>{concepts.find((x) => x.id === r)?.name ?? r}</a></>
            ))}
          </p>
        )}
      </div>
    ))}
  </div>

  <p class="caption">The game's own encyclopedia text, dynamic values elided as …</p>

  <script is:inline>
    const filter = document.getElementById('page-filter');
    if (filter) {
      const cards = [...document.querySelectorAll('.concept')];
      filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        for (const c of cards) c.classList.toggle('is-hidden', !!q && !c.dataset.name.includes(q));
      });
    }
  </script>

  <style is:global>
    .concepts { columns: 3 22rem; column-gap: 1.2rem; }
    .concept {
      break-inside: avoid;
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.7rem 0.9rem;
      margin-bottom: 0.8rem;
    }
    .concept__name { font-family: var(--font-display); font-size: 1.02rem; margin-bottom: 0.25rem; }
    .concept__desc { margin: 0; font-size: 0.8rem; color: var(--text-soft); line-height: 1.45; white-space: pre-line; }
    .concept__rel { margin: 0.35rem 0 0; font-size: 0.72rem; color: var(--text-dim); }
  </style>
</Base>
