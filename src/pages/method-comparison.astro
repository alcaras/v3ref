---
import Base from '../layouts/Base.astro';
import TableTools from '../components/TableTools.astro';
import PriceRail from '../components/PriceRail.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  title="Compare Buildings"
  active="method-comparison"
  eyebrow="Tools"
  description="Every Victoria 3 production method priced at your market, sortable by profit, profit per worker, and profit per point of construction."
>
  <div class="mc">
    <aside class="rail">
      <PriceRail />
      <div>
        <div class="rail__label">
          <span>Market prices</span>
          <button type="button" id="mc-reset" class="rail__btn">reset</button>
        </div>
        <input id="mc-goodfilter" class="rail__select" type="search" placeholder="Find a good…"
          style="margin-bottom:0.5rem;" />
        <div id="mc-prices"></div>
      </div>
    </aside>

    <div class="mc__main">
      <p class="bp__cross">
        Every building at its best production set for your market and target. To break one building
        down group by group, use <a href={`${base}profit-calculator`}>Building Profit →</a>
      </p>

      <div class="mc__target">
        <label class="mc__field mc__field--opt">
          <span class="rail__label" style="margin-right:0.4rem;">Optimise for</span>
          <select id="mc-opt" class="rail__select" style="min-width:16rem;">
            <option value="constr">Profit per construction point</option>
            <option value="worker">Profit per worker</option>
          </select>
        </label>
        <span class="mc__hint">Sort by any column to override.</span>
      </div>

      <!-- Only rendered once a save has been read; see renderAudit(). -->
      <details id="mc-audit" class="aud" hidden open>
        <summary class="aud__head">
          <h2 class="aud__title">Your buildings: methods to change</h2>
          <span class="aud__sum" id="aud-sum"></span>
        </summary>
        <div class="grid"><div class="grid__scroll">
          <table class="vtbl aud__table" id="aud-table">
            <thead>
              <tr>
                <th style="min-width: 11rem;">Building</th>
                <th style="min-width: 22rem;">Group · now → change to</th>
                <th class="num" title="Total levels running this set">Levels</th>
                <th class="num">£/level</th>
                <th class="num">£/week</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div></div>
        <p class="aud__note" id="aud-note"></p>
      </details>

      <h2 class="mc__h2">Every building, at the best set it could run</h2>
      <div class="mc__bar">
        <label class="mc__field">
          <input id="mc-filter" type="search" class="rail__select" style="min-width:18rem;"
            placeholder="Filter by building, method, or good…" />
        </label>
        <label class="mc__toggle"><input type="checkbox" id="mc-positive" /> only profitable</label>
        <label class="mc__toggle" title="Wonders and the great canals: one per world, so they are not something to build more of">
          <input type="checkbox" id="mc-standard" checked /> standard buildings only</label>
        <span id="mc-count" class="mc__hint"></span>
      </div>

      <TableTools showBar={false} />
      <div class="grid"><div class="grid__scroll">
        <table class="vtbl" id="mc-table" data-sortable>
          <thead>
            <tr>
              <th style="min-width: 12rem;">Building</th>
              <th style="min-width: 16rem;" title="The method from each group that wins for the chosen target">Best set</th>
              <th class="num" title="Revenue − input cost at your prices, per building level">Net £</th>
              <th class="num" title="Jobs this method adds per level">Workers</th>
              <th class="num" title="Net £ per worker employed">£/worker</th>
              <th class="num" title="Construction points the building costs">Constr.</th>
              <th class="num" title="Net £ per point of construction — payback on building it">£/constr.</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div></div>

      <p class="caption">
        Revenue − input cost at your prices, per level, at full employment. One method from every
        group, best combination searched. Prices, target and save shared with
        <a href={`${base}profit-calculator`}>Building Profit</a>.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ base }}>
    (async () => {
      const data = await fetch(`${base}data/profit-calc.json`).then((r) => r.json());
      window.v3ImportGoods = data.goods;
      window.v3CountryName = data.countries;   // lets the importer name each seat
      document.dispatchEvent(new CustomEvent('v3data-ready'));
      document.addEventListener('v3prices-changed', () => { renderPrices(); renderTable(); renderAudit(); });
      document.addEventListener('v3save-changed', renderAudit);
      const $ = (id) => document.getElementById(id);
      const P = window.v3Prices;
      const priceOf = (g) => P.of(data.goods, g);
      const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

      // One row per BUILDING, run as an actual building would be: one method
      // from every group. A lone method is not a thing you can build — comparing
      // methods in isolation implies combinations that cannot exist and hides
      // the inputs their siblings add.
      const usedGoods = new Set();
      const buildings = data.buildings.map((b) => {
        const groups = b.pmGroups.map((g, gi) => ({ gi, g })).filter(({ g }) => g.pms.length);
        let combos = [{}];
        for (const { gi, g } of groups) {
          const next = [];
          for (const c of combos) for (let pi = 0; pi < g.pms.length; pi++) next.push({ ...c, [gi]: pi });
          combos = next;
        }
        for (const g of b.pmGroups)
          for (const pm of g.pms)
            for (const l of [...pm.inputs, ...pm.outputs]) usedGoods.add(l.g);
        return {
          b, groups, combos,
          search: `${b.name} ${b.group ?? ''} ${b.pmGroups
            .flatMap((g) => g.pms.map((pm) => pm.name)).join(' ')} ${b.pmGroups
            .flatMap((g) => g.pms.flatMap((pm) => [...pm.inputs, ...pm.outputs]
              .map((l) => data.goods[l.g]?.name ?? l.g))).join(' ')}`.toLowerCase(),
        };
      }).filter((r) => r.combos.length);
      const byId = Object.fromEntries(buildings.map((r) => [r.b.id, r]));

      // The sign belongs in front of the £, not between it and the digits.
      const money = (v) =>
        `${v < 0 ? '−' : ''}£${Math.round(Math.abs(v)).toLocaleString()}`;

      // A handful of methods need a SIBLING method in another group — Bone
      // China only runs on Crystal Glass or Houseware Plastics. Combinations
      // that break that cannot be built, so they must not win a row.
      function buildable(r, choice) {
        let picked = null;
        for (const gi of Object.keys(choice)) {
          const pm = r.b.pmGroups[gi].pms[choice[gi]];
          if (!pm?.reqPms) continue;
          picked ??= new Set(Object.keys(choice).map((k) => r.b.pmGroups[k].pms[choice[k]]?.id));
          if (!pm.reqPms.some((id) => picked.has(id))) return false;
        }
        return true;
      }

      // Evaluate one full building configuration.
      function evalCombo(r, choice) {
        const flow = {}, jobs = {};
        for (const gi of Object.keys(choice)) {
          const pm = r.b.pmGroups[gi].pms[choice[gi]];
          if (!pm) continue;
          for (const l of pm.inputs) flow[l.g] = (flow[l.g] ?? 0) - l.a;
          for (const l of pm.outputs) flow[l.g] = (flow[l.g] ?? 0) + l.a;
          for (const j of pm.jobs) jobs[j.p] = (jobs[j.p] ?? 0) + j.a;
        }
        let net = 0;
        for (const [g, u] of Object.entries(flow)) net += u * priceOf(g);
        const totalJobs = Object.values(jobs).reduce((s, a) => s + a, 0);
        return { net, totalJobs };
      }

      // What "better" means, in one place. Construction cost is a property of
      // the building and no method changes it, so INSIDE one building £/constr
      // is £ divided by a constant — the same ordering as total profit. Only
      // £/worker actually reorders a building's own options.
      const score = (e, mode, constr) =>
        mode === 'worker' ? (e.totalJobs > 0 ? e.net / e.totalJobs : -Infinity)
        : mode === 'constr' ? (constr ? e.net / constr : e.net)
        : e.net;

      // The best configuration for the chosen target. The space is small (108
      // at the widest), so this is exhaustive rather than assuming the per-group
      // winners combine — which holds for total profit but not for the ratios.
      function bestFor(r, mode, constr) {
        let best = null;
        for (const c of r.combos) {
          if (!buildable(r, c)) continue;
          const e = evalCombo(r, c);
          const sc = score(e, mode, constr);
          if (!best || sc > best.score) best = { c, ...e, score: sc };
        }
        return best;
      }

      // ── Shading ────────────────────────────────────────────────────
      // Sign alone gives two buckets, which is not enough to scan a column by.
      // Each number is shaded against the largest of its own column on screen,
      // on a gentle curve so the middle of the range stays distinguishable.
      function mag(v, max, text) {
        if (v == null) return '<span class="cell__dash">—</span>';
        const t = max > 0 ? Math.min(1, Math.pow(Math.abs(v) / max, 0.55)) : 0;
        const cls = v > 0 ? 'mag mag--good' : v < 0 ? 'mag mag--bad' : 'tone-neutral';
        return `<span class="${cls}${t > 0.86 ? ' mag--peak' : ''}" style="--m:${(0.2 + 0.8 * t).toFixed(3)}">${text}</span>`;
      }

      // ── Price rail: every good any method touches ──────────────────
      const goodList = [...usedGoods].sort((a, b) =>
        data.goods[a].name.localeCompare(data.goods[b].name));

      function renderPrices() {
        const q = $('mc-goodfilter').value.trim().toLowerCase();
        const list = goodList.filter((g) => !q || data.goods[g].name.toLowerCase().includes(q));
        $('mc-prices').innerHTML = list.map((g) => `
          <div class="prow">
            <div class="prow__head">
              <img src="${base}${data.goods[g].icon}" alt="" loading="lazy" />
              <span class="prow__name">${data.goods[g].name}</span>
              <span class="prow__val" data-val="${g}"></span>
            </div>
            <input type="range" min="-75" max="75" step="1" value="${P.get(g)}" data-good="${g}" />
          </div>`).join('');
        $('mc-prices').querySelectorAll('input[data-good]').forEach((input) =>
          input.addEventListener('input', () => {
            P.set(input.dataset.good, Number(input.value));
            renderPriceLabels();
            renderTable();
            renderAudit();
          }));
        renderPriceLabels();
      }

      function renderPriceLabels() {
        for (const el of $('mc-prices').querySelectorAll('[data-val]')) {
          const g = el.dataset.val, pct = P.get(g);
          el.textContent = `£${priceOf(g).toFixed(0)}${pct ? ` (${pct > 0 ? '+' : ''}${pct}%)` : ''}`;
          el.classList.toggle('is-off', pct !== 0);
        }
      }

      // ── The audit: what the save has set, versus what it should ────
      //
      // Only buildings that SELL something are ranked. A building that merely
      // consumes goods — construction sector, government administration, trade
      // centre, university — produces construction points, bureaucracy, trade
      // capacity or innovation, none of which is priced here, so "spend least
      // on inputs" would come out as "best" and the advice would be backwards.
      function sells(r) {
        return r.b.pmGroups.some((g) => g.pms.some((pm) => pm.outputs.length));
      }

      function auditRows(country, mode) {
        const techs = new Set(country.techs ?? []);
        const laws = new Set(country.laws ?? []);
        const prin = new Set(country.principles ?? []);
        const ident = country.identity ?? null;
        // Only what the save says this country can actually run today.
        const canRun = (pm) =>
          (!pm.techs || pm.techs.every((t) => techs.has(t)))
          && (!pm.laws || pm.laws.some((l) => laws.has(l)))
          && (!pm.blocked || !pm.blocked.some((l) => laws.has(l)))
          && (!pm.reqPrin || pm.reqPrin.some((x) => prin.has(x)))
          && (!pm.reqIdent || pm.reqIdent.includes(ident))
          // Company category, region, religion: a save cannot answer these, so
          // the method is never put forward.
          && !pm.unverified;

        const merged = new Map();
        const skipped = new Set();
        let unreadable = 0, checked = 0;

        for (const row of country.buildings ?? []) {
          const r = byId[row.b];
          if (!r) continue;                       // moves no goods; not in this dataset
          if (!sells(r)) { skipped.add(r.b.name); continue; }

          // Match the save's method list onto this building's groups. A group we
          // cannot place (a patch renamed it, say) is dropped from BOTH sides:
          // every goods line in the game is a flat amount, so groups do not
          // interact and leaving one out shifts current and best equally.
          const live = [];
          const cur = {};
          for (const { gi, g } of r.groups) {
            const pi = g.pms.findIndex((pm) => row.pms.includes(pm.id));
            if (pi < 0) { unreadable++; continue; }
            live.push({ gi, g });
            cur[gi] = pi;
          }
          if (!live.length) continue;
          checked++;

          let combos = [{}];
          for (const { gi, g } of live) {
            const opts = g.pms
              .map((pm, pi) => ({ pm, pi }))
              .filter(({ pm, pi }) => pi === cur[gi] || canRun(pm));
            const next = [];
            for (const c of combos) for (const { pi } of opts) next.push({ ...c, [gi]: pi });
            combos = next;
          }
          const constr = r.b.construction;
          const now = evalCombo(r, cur);
          // Seed with what the save is running: whatever our data says, the
          // game is already running it, so it is by definition an option.
          let best = { c: cur, ...now, score: score(now, mode, constr) };
          for (const c of combos) {
            if (!buildable(r, c)) continue;
            const e = evalCombo(r, c);
            const sc = score(e, mode, constr);
            if (sc > best.score) best = { c, ...e, score: sc };
          }
          const gain = best.net - now.net;
          const jobs = best.totalJobs - now.totalJobs;
          // Under the per-worker target a switch can trade total £ for labour,
          // so "better" is the target improving, not £ going up.
          if (best.score <= score(now, mode, constr) + 1e-9) continue;
          if (mode !== 'worker' && gain <= 0.5) continue;

          const changes = live.filter(({ gi }) => best.c[gi] !== cur[gi])
            .map(({ gi, g }) => ({ group: g.name, from: g.pms[cur[gi]], to: g.pms[best.c[gi]] }));
          if (!changes.length) continue;
          const keep = live.filter(({ gi }) => best.c[gi] === cur[gi])
            .map(({ gi, g }) => g.pms[cur[gi]].name);

          // Two buildings of the same type making the same switch gain the same
          // per level, whatever else differs about them, so they belong on one
          // row rather than three near-identical ones.
          const key = r.b.id + '|' + changes.map((c) => `${c.group}:${c.from.id}>${c.to.id}`).join('|');
          const hit = merged.get(key) ?? { r, changes, gain, jobs, lv: 0, n: 0, keep };
          hit.lv += row.lv; hit.n += row.n;
          // Rows merge on the switch, so only claim the untouched groups where
          // every building behind the row agrees on them.
          if (hit.keep && hit.keep.join() !== keep.join()) hit.keep = null;
          merged.set(key, hit);
        }
        const rank = (x) => (mode === 'worker' ? x.jobs * -1 : x.gain) * x.lv;
        const rows = [...merged.values()].sort((a, b) => rank(b) - rank(a));
        return { rows, skipped: [...skipped], unreadable, checked };
      }

      function renderAudit() {
        const el = $('mc-audit');
        const mode = $('mc-opt').value;
        const country = window.v3Save?.country?.();
        if (!country || !country.buildings?.length) { el.hidden = true; return; }
        el.hidden = false;

        const { rows, skipped, unreadable, checked } = auditRows(country, mode);
        const total = rows.reduce((s, r) => s + r.gain * r.lv, 0);
        const jobs = rows.reduce((s, r) => s + r.jobs * r.lv, 0);
        const switches = rows.reduce((s, r) => s + r.changes.length, 0);
        const maxWeek = Math.max(0, ...rows.map((r) => Math.abs(r.gain * r.lv)));
        const maxLevel = Math.max(0, ...rows.map((r) => Math.abs(r.gain)));
        const name = window.v3CountryName?.[country.tag] ?? country.tag;
        const plural = (n, one, many) => `${n.toLocaleString()} ${n === 1 ? one : many}`;

        $('aud-sum').innerHTML = rows.length
          ? `${plural(rows.length, 'building', 'buildings')} · `
            + `${plural(switches, 'method to switch', 'methods to switch')} · `
            + `<b class="${total >= 0 ? 'tone-good' : 'tone-bad'}">${money(total)}</b> a week`
            + (mode === 'worker' && jobs
              ? ` · ${jobs < 0 ? plural(-jobs, 'worker freed', 'workers freed')
                               : plural(jobs, 'worker hired', 'workers hired')}`
              : '')
          : '<span class="tone-good">nothing to change — every method is already the best one available</span>';

        $('aud-table').closest('.grid').hidden = !rows.length;
        $('aud-table').tBodies[0].innerHTML = rows.map((r) => `
          <tr>
            <td class="lead-cell">
              <span class="lead"><img class="lead__icon" src="${base}${r.r.b.icon}" alt="" loading="lazy" />
              <a href="${base}buildings/${r.r.b.id.replace('building_', '')}">${esc(r.r.b.name)}</a></span></td>
            <td class="aud__sw">${r.changes.map((c) => `
              <span class="aud__one">
                <i class="aud__grp">${esc(c.group)}</i>
                <span class="aud__from">${esc(c.from.name)}</span>
                <b>→</b>
                <span class="aud__to">${esc(c.to.name)}</span>
              </span>`).join('')}${
              r.keep && r.keep.length
                ? `<span class="aud__keep"><i class="aud__grp">leave</i>${esc(r.keep.join(' · '))}</span>`
                : ''}</td>
            <td class="num dim">${r.lv.toLocaleString()}<span class="aud__n"> in ${r.n}</span></td>
            <td class="num">${mag(r.gain, maxLevel, `${r.gain > 0 ? '+' : r.gain < 0 ? '−' : ''}£${Math.abs(r.gain).toFixed(1)}`)}</td>
            <td class="num">${mag(r.gain * r.lv, maxWeek, `${r.gain > 0 ? '+' : r.gain < 0 ? '−' : ''}£${Math.round(Math.abs(r.gain * r.lv)).toLocaleString()}`)}</td>
          </tr>`).join('');

        $('aud-note').innerHTML = [
          `<b>${esc(name)}</b> · ${checked} building sets · goods margin at full employment`,
          skipped.length ? `sells nothing, not ranked: ${skipped.map(esc).join(', ')}` : '',
          unreadable ? `${unreadable} groups didn't match this patch` : '',
        ].filter(Boolean).join(' · ');
      }

      // ── Table ──────────────────────────────────────────────────────
      // The control and the clickable headers drive the same sort, so the two
      // can never disagree: choosing a target just sets that column's header.
      const OPT_COL = { worker: 4, constr: 6 };   // £/worker, £/constr
      function applyOpt() {
        const want = OPT_COL[$('mc-opt').value];
        [...$('mc-table').tHead.rows[0].cells].forEach((th, i) =>
          th.setAttribute('aria-sort', i === want ? 'descending' : 'none'));
        renderTable();
      }

      function renderTable() {
        const q = $('mc-filter').value.trim().toLowerCase();
        const onlyPositive = $('mc-positive').checked;
        const standardOnly = $('mc-standard').checked;
        const mode = $('mc-opt').value;
        const rows = [];
        let hiddenUnique = 0;
        for (const r of buildings) {
          if (r.b.unique) { hiddenUnique++; if (standardOnly) continue; }
          if (q && !r.search.includes(q)) continue;
          const constr = r.b.construction;
          const best = bestFor(r, mode, constr);
          if (!best) continue;
          if (onlyPositive && best.net <= 0) continue;
          rows.push({
            r, best, constr,
            perWorker: best.totalJobs > 0 ? best.net / best.totalJobs : null,
            perConstruction: constr ? best.net / constr : null,
            setNames: r.groups.map(({ gi }) => r.b.pmGroups[gi].pms[best.c[gi]].name),
          });
        }

        // Shade each column against the biggest number actually on screen, so
        // the scale follows the filter rather than the whole game.
        const peak = (pick) => Math.max(0, ...rows.map((x) => Math.abs(pick(x) ?? 0)));
        const mNet = peak((x) => x.best.net);
        const mWkr = peak((x) => x.perWorker);
        const mCon = peak((x) => x.perConstruction);
        const num = (v, d) => v.toFixed(d);

        const out = rows.map((x) => ({
          sort: [x.r.b.name, x.setNames.join(', '), x.best.net, x.best.totalJobs,
                 x.perWorker, x.constr, x.perConstruction],
          html: `<tr>
            <td class="lead-cell" data-sort="${x.r.b.name}">
              <span class="lead"><img class="lead__icon" src="${base}${x.r.b.icon}" alt="" loading="lazy" />
              <a href="${base}buildings/${x.r.b.id.replace('building_', '')}">${x.r.b.name}</a></span></td>
            <td class="dim mc__set">${x.setNames.join(' · ')}</td>
            <td class="num" data-sort="${x.best.net.toFixed(2)}">${mag(x.best.net, mNet, money(x.best.net))}</td>
            <td class="num dim" data-sort="${x.best.totalJobs || ''}">${
              x.best.totalJobs ? x.best.totalJobs.toLocaleString() : '<span class="cell__dash">—</span>'}</td>
            <td class="num" data-sort="${x.perWorker ?? ''}">${
              x.perWorker == null ? '<span class="cell__dash">—</span>' : mag(x.perWorker, mWkr, num(x.perWorker, 3))}</td>
            <td class="num dim" data-sort="${x.constr ?? ''}">${x.constr ?? '<span class="cell__dash">—</span>'}</td>
            <td class="num" data-sort="${x.perConstruction ?? ''}">${
              x.perConstruction == null ? '<span class="cell__dash">—</span>' : mag(x.perConstruction, mCon, num(x.perConstruction, 2))}</td>
          </tr>`,
        }));

        // Re-apply the active sort: TableTools sorts the live DOM and we just
        // replaced every row.
        const heads = [...$('mc-table').tHead.rows[0].cells];
        const col = heads.findIndex((th) => (th.getAttribute('aria-sort') ?? 'none') !== 'none');
        if (col >= 0) {
          const dir = heads[col].getAttribute('aria-sort') === 'ascending' ? 1 : -1;
          out.sort((a, b) => {
            const av = a.sort[col], bv = b.sort[col];
            if (av == null && bv == null) return 0;
            if (av == null) return 1;
            if (bv == null) return -1;
            return (typeof av === 'number' ? av - bv : String(av).localeCompare(String(bv))) * dir;
          });
        }
        $('mc-table').tBodies[0].innerHTML = out.map((r) => r.html).join('');
        const pool = buildings.length - ($('mc-standard').checked ? hiddenUnique : 0);
        $('mc-count').textContent = `${out.length} of ${pool} buildings`;
        $('mc-table').tBodies[0].querySelectorAll('tr').forEach((tr) => tr.removeAttribute('data-tt-i'));
      }

      $('mc-opt').addEventListener('change', () => { applyOpt(); renderAudit(); });
      $('mc-filter').addEventListener('input', renderTable);
      $('mc-positive').addEventListener('change', renderTable);
      $('mc-standard').addEventListener('change', renderTable);
      try {
        $('mc-audit').open = localStorage.getItem('v3ref-audit-open') !== '0';
      } catch {}
      $('mc-audit').addEventListener('toggle', () => {
        try { localStorage.setItem('v3ref-audit-open', $('mc-audit').open ? '1' : '0'); } catch {}
      });
      $('mc-goodfilter').addEventListener('input', renderPrices);
      $('mc-reset').addEventListener('click', () => { P.reset(); renderPrices(); renderTable(); renderAudit(); });
      renderPrices();
      applyOpt();   // open on total profit, ranked
      renderAudit();
    })();
  </script>

  <style is:global>
