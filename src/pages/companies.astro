---
import Base from '../layouts/Base.astro';
import TableTools from '../components/TableTools.astro';
import ModifierList from '../components/ModifierList.astro';
import companiesJson from '../data/companies.json';

const base = import.meta.env.BASE_URL;
const companies = (companiesJson as any).companies as any[];
const flavored = companies.filter((c) => c.flavored);
const basic = companies.filter((c) => !c.flavored);

const csv = {
  header: ['Company', 'Id', 'Flavored', 'Buildings', 'Charter extensions', 'Prestige goods', 'Preferred HQ', 'Prosperity bonus'],
  rows: companies.map((c) => [
    c.name, c.id, c.flavored ? 'yes' : '', c.buildings.map((b: any) => b.name).join('; '),
    c.extensionBuildings.map((b: any) => b.name).join('; '),
    c.prestigeGoods.map((p: any) => p.name).join('; '),
    c.preferredHq.map((s: any) => s.name).join('; '),
    c.prosperity.map((m: any) => `${m.valueText} ${m.label}`).join('; '),
  ]),
};

const section = (list: any[], title: string) => ({ list, title });
const sections = [section(flavored, 'Historical companies'), section(basic, 'Basic companies')];
---
<Base
  title="Companies"
  active="companies"
  eyebrow="Economy"
  pageFilter="Filter companies…"
  pageStats={[
    { value: flavored.length, label: 'historical' },
    { value: basic.length, label: 'basic' },
  ]}
>
  <p class="moved">
    Planning which companies to run? The
    <a href="https://alcaras.github.io/v3co/">Company Analysis Tool</a> has a coverage matrix,
    a seven-slot optimiser and prestige-good filters. This page is the reference data behind it.
  </p>

  <TableTools csvId="companies" csvName="victoria3-companies" />

  {sections.map(({ list, title }) => (
    <div data-cogroup>
      <h2 class="sect">{title}</h2>
      <div class="grid"><div class="grid__scroll">
        <table class="vtbl">
          <thead>
            <tr>
              <th style="min-width: 15rem;">Company</th>
              <th style="min-width: 14rem;">Buildings</th>
              <th style="width: 12rem;">Charter extensions</th>
              <th style="min-width: 16rem;">Prosperity bonus</th>
              <th style="width: 11rem;">Prestige goods</th>
              <th style="width: 12rem;">Preferred HQ</th>
            </tr>
          </thead>
          <tbody>
            {list.map((c) => (
              <tr id={c.id} data-name={`${c.name} ${c.id} ${c.buildings.map((b: any) => b.name).join(' ')} ${c.preferredHq.map((s: any) => s.name).join(' ')}`.toLowerCase()}>
                <td class="lead-cell">
                  <span class="lead">
                    <img class="lead__icon" src={`${base}${c.icon}`} alt="" loading="lazy" />
                    {c.name}
                  </span>
                </td>
                <td class="dim">
                  {c.buildings.map((b: any, i: number) => (
                    <>{i > 0 && ', '}<a href={`${base}buildings/${b.slug}`}>{b.name}</a></>
                  ))}
                </td>
                <td class="dim">
                  {c.extensionBuildings.length ? c.extensionBuildings.map((b: any, i: number) => (
                    <>{i > 0 && ', '}<a href={`${base}buildings/${b.slug}`}>{b.name}</a></>
                  )) : <span class="cell__dash">—</span>}
                </td>
                <td><ModifierList mods={c.prosperity} inline /></td>
                <td class="dim">{c.prestigeGoods.length ? c.prestigeGoods.map((p: any) => p.name).join(', ') : <span class="cell__dash">—</span>}</td>
                <td class="dim">
                  {c.preferredHq.length ? c.preferredHq.map((s: any, i: number) => (
                    <>{i > 0 && ', '}<a href={`${base}states#${s.id}`}>{s.name}</a></>
                  )) : <span class="cell__dash">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div></div>
    </div>
  ))}

  <p class="caption">Formation requirements are scripted per company (building levels in specific states) — HQ column is the location hint</p>

  <script is:inline define:vars={{ csv }}>
    window.v3Csv = window.v3Csv || {};
    window.v3Csv.companies = () => csv;
  </script>

  <script is:inline>
    const filter = document.getElementById('page-filter');
    if (filter) {
      const rows = [...document.querySelectorAll('tbody tr[data-name]')];
      filter.addEventListener('input', () => {
        const q = filter.value.trim().toLowerCase();
        for (const r of rows) r.classList.toggle('is-hidden', !!q && !r.dataset.name.includes(q));
        document.querySelectorAll('[data-cogroup]').forEach((wrap) => {
          const any = [...wrap.querySelectorAll('tbody tr[data-name]')].some((r) => !r.classList.contains('is-hidden'));
          wrap.classList.toggle('is-hidden', !any);
        });
      });
    }
  </script>
  <style is:global>
    .moved {
      font-size: 0.82rem; line-height: 1.5; max-width: 46rem; margin: 0 0 0.8rem;
      padding: 0.5rem 0.8rem; border-left: 3px solid var(--gold-deep);
      background: var(--bg-elev); border-radius: 0 6px 6px 0; color: var(--text-soft);
    }
  </style>
</Base>
